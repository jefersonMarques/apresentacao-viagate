# Copy to /etc/viagate-commercial/viagate.env and replace every placeholder.
APP_ENV=production
APP_ADDR=127.0.0.1:8080
APP_BASE_URL=https://comercial.example.com

# For a local PostgreSQL instance on the same host, sslmode=disable is acceptable
# when PostgreSQL listens only on loopback. For a remote managed database, use TLS.
DATABASE_URL=postgres://viagate:CHANGE_ME@127.0.0.1:5432/viagate?sslmode=disable

# Use the actual executable installed on the production host.
CHROMIUM_PATH=/usr/bin/chromium

# Enable only when APP_ADDR is private/loopback and the reverse proxy overwrites
# X-Forwarded-For/X-Real-IP before forwarding traffic to this process.
TRUST_PROXY_HEADERS=true
REQUIRE_ONBOARDING_REVIEW=true

SESSION_COOKIE_NAME=viagate_session
SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=48
SIGNATURE_OTP_TTL_MINUTES=10

VIAGATE_LEGAL_NAME="REPLACE WITH OFFICIAL LEGAL NAME"
VIAGATE_CNPJ=00000000000000

# AWS S3 example. Keep the bucket private. Leave S3_ENDPOINT empty for AWS.
S3_REGION=sa-east-1
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
S3_DOWNLOAD_TTL_MINUTES=5

BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
BREVO_SENDER_EMAIL=naoresponda@viagate.com.br
BREVO_SENDER_NAME=ViaGate

COMPANY_REGISTRY_PROVIDER=brasilapi
COMPANY_REGISTRY_TIMEOUT_SECONDS=4

# Use only for the very first installation when there is no Super Admin yet.
# Remove these values after the account is activated.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
