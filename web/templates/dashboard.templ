package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/domain"

templ AdminDashboardPage(user domain.User, items []DashboardRecord) {
	@AdminLayout("ViaGate — Visão geral", user) {
		@AdminPageHeader("VISÃO GERAL", "Registros comerciais", "Propostas e apresentações em uma única visão, organizadas por tipo e status.") {
			<a class="btn" href="/admin/presentations/new">Nova apresentação</a>
			<a class="btn primary" href="/admin/proposals/new">Nova proposta</a>
		}

		<section class="metric-grid" aria-label="Resumo">
			<article class="metric-card">
				<span>Total de registros</span>
				<strong>{ len(items) }</strong>
			</article>
			<article class="metric-card">
				<span>Propostas</span>
				<strong>{ DashboardCountByKind(items,"proposal") }</strong>
			</article>
			<article class="metric-card">
				<span>Apresentações</span>
				<strong>{ DashboardCountByKind(items,"presentation") }</strong>
			</article>
			<article class="metric-card">
				<span>Publicados / aceitos</span>
				<strong>{ DashboardActiveCount(items) }</strong>
			</article>
		</section>

		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "registro(s)") {
				@AdminListSearch("Buscar cliente, título ou comercial...")
				@AdminListFilter("Tipo", "kind") {
					<option value="">Todos os tipos</option>
					<option value="proposal">Propostas</option>
					<option value="presentation">Apresentações</option>
				}
				@AdminListFilter("Status", "status") {
					<option value="">Todos os status</option>
					<option value="draft">Rascunho</option>
					<option value="published">Publicado</option>
					<option value="accepted">Aceito</option>
					<option value="expired">Expirado</option>
					<option value="cancelled">Cancelado</option>
				}
			}
			@AdminDataTable([]string{"Tipo", "Cliente", "Registro", "Status", "Comercial", "Versão / validade", "Atualizado", "Ações"}, len(items), "Nenhum registro criado ainda.") {
				for _, item := range items {
					<tr data-admin-list-row data-filter-kind={ item.Kind } data-filter-status={ item.Status } data-search={ item.ClientName + " " + item.Title + " " + item.OwnerName }>
						<td data-label="Tipo"><span class={ "badge kind-badge " + item.Kind }>{ item.KindLabel }</span></td>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Registro"><span class="record-title">{ item.Title }</span></td>
						<td data-label="Status">
							if item.Kind == "proposal" && item.Status == "accepted" {
								<span class="badge status-badge status-success">Aceita · bloqueada</span>
							} else {
								<span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ humanStatus(item.Status) }</span>
							}
						</td>
						<td data-label="Comercial">{ item.OwnerName }</td>
						<td data-label="Versão / validade">
							<span class="record-meta">{ DashboardVersionLabel(item) }</span>
							if item.ValidUntil != nil {
								<small>até { Date(item.ValidUntil) }</small>
							}
						</td>
						<td data-label="Atualizado"><span class="record-meta">{ item.UpdatedAt.Format("02/01/2006") }</span><small>{ item.UpdatedAt.Format("15:04") }</small></td>
						<td data-label="Ações" data-actions="true">
							<div class="admin-list-actions">
								if item.EditURL != "" {
									<a class="btn" href={ templ.SafeURL(item.EditURL) }>Editar</a>
								} else if item.PublicURL != "" {
									<a class="btn dark" target="_blank" rel="noopener" href={ templ.SafeURL(item.PublicURL) }>Abrir</a>
								}
								if item.Kind == "proposal" || item.PublicURL != "" {
									@AdminActionMenu("Mais ações do registro") {
										if item.Kind == "proposal" {
											<a href={ templ.SafeURL("/admin/proposals/new?duplicate=" + item.ID) }>Duplicar proposta</a>
										}
										if item.PublicURL != "" {
											<a target="_blank" rel="noopener" href={ templ.SafeURL(item.PublicURL) }>Abrir versão pública</a>
										}
									}
								}
							</div>
						</td>
					</tr>
				}
			}
		</div>
	}
}
