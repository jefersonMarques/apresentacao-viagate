package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/domain"

templ PipelinePage(user domain.User, items []domain.PipelineItem, all bool) {
	@AdminLayout("ViaGate — Pipeline comercial",user) {
		<header class="header"><div><span class="step-title">PIPELINE</span><h1>Contratações em andamento</h1><p>Acompanhe a negociação da publicação da proposta até o cadastro operacional e a assinatura do contrato.</p></div><div class="actions"><a class="btn primary" href="/admin/proposals/new">Nova proposta</a></div></header>
		if all {
			<div class="notice">Visão global habilitada: você está vendo negociações de todos os comerciais.</div>
		}
		<section class="panel"><div class="table-wrap"><table class="table"><thead><tr><th>Cliente</th><th>Comercial</th><th>Etapa</th><th>Proposta</th><th>Última atividade</th><th></th></tr></thead><tbody>
			for _,item := range items {
				<tr>
					<td><strong>{ item.ClientName }</strong></td>
					<td>{ item.CommercialName }</td>
					<td><span class="badge">{ PipelineStage(item) }</span></td>
					<td>{ item.ProposalTitle }</td>
					<td>{ item.UpdatedAt.Format("02/01/2006 15:04") }</td>
					<td><a class="btn" href={ templ.SafeURL("/admin/pipeline/" + item.ProposalID) }>Detalhes</a></td>
				</tr>
			}
			if len(items)==0 {
				<tr><td colspan="6">Nenhuma negociação encontrada.</td></tr>
			}
		</tbody></table></div></section>
	}
}

templ PipelineDetailPage(user domain.User,item domain.PipelineItem,events []domain.PipelineEvent) {
	@AdminLayout("ViaGate — Negociação",user) {
		<header class="header"><div><span class="step-title">NEGOCIAÇÃO</span><h1>{ item.ClientName }</h1><p>{ item.ProposalTitle } · responsável comercial: { item.CommercialName }</p></div><div class="actions"><a class="btn" href="/admin/pipeline">Voltar</a><a class="btn dark" href={ templ.SafeURL("/admin/proposals/" + item.ProposalID + "/edit") }>Abrir proposta</a></div></header>
		<section class="panel"><div class="panel-head"><h2>Etapa atual</h2><span class="badge success">{ PipelineStage(item) }</span></div><div class="panel-body">
			<div class="pipeline-stage">
				<span>Proposta: { humanStatus(item.ProposalStatus) }</span>
				if item.OnboardingStatus!="" {
					<span>Cadastro: { humanStatus(item.OnboardingStatus) }</span>
				}
				if item.ContractStatus!="" {
					<span>Contrato: { humanStatus(item.ContractStatus) }</span>
				}
			</div>
			<div class="grid" style="margin-top:18px">
				if item.AcceptedAt != nil {
					<div><small>Proposta aceita</small><strong style="display:block;margin-top:4px">{ item.AcceptedAt.Format("02/01/2006 15:04") }</strong></div>
				}
				if item.SubmittedAt != nil {
					<div><small>Cadastro enviado</small><strong style="display:block;margin-top:4px">{ item.SubmittedAt.Format("02/01/2006 15:04") }</strong></div>
				}
				if item.FullySignedAt != nil {
					<div><small>Contrato assinado</small><strong style="display:block;margin-top:4px">{ item.FullySignedAt.Format("02/01/2006 15:04") }</strong></div>
				}
			</div>
		</div></section>
		<section class="panel"><div class="panel-head"><h2>Histórico</h2></div><div class="panel-body timeline">
			for _,event := range events {
				<article class="timeline-item"><strong>{ EventLabel(event.EventType) }</strong><small style="display:block;margin-top:5px">{ event.CreatedAt.Format("02/01/2006 15:04:05") } · { EventActor(event) }</small></article>
			}
			if len(events)==0 {
				<p>Nenhum evento de auditoria registrado ainda.</p>
			}
		</div></section>
	}
}
