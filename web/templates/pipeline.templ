package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/domain"

templ PipelinePage(user domain.User, items []domain.PipelineItem, all bool) {
	@AdminLayout("ViaGate — Pipeline comercial", user) {
		@AdminPageHeader("PIPELINE", "Contratações e ativações", "Acompanhe da publicação da proposta à assinatura do contrato, dados para ativação e liberação da operação.") {
			<a class="btn primary" href="/admin/proposals/new">Nova proposta</a>
		}
		if all {
			<div class="notice">Visão global habilitada: você está vendo negociações de todos os comerciais.</div>
		}
		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "negociação(ões)") {
				@AdminListSearch("Buscar cliente, proposta ou comercial...")
				@AdminListFilter("Etapa", "stage") {
					<option value="">Todas as etapas</option>
					for _, stage := range PipelineStages(items) {
						<option value={ stage }>{ stage }</option>
					}
				}
				if all {
					@AdminListFilter("Comercial", "commercial") {
						<option value="">Todos os comerciais</option>
						for _, commercial := range PipelineCommercials(items) {
							<option value={ commercial }>{ commercial }</option>
						}
					}
				}
			}
			@AdminDataTable([]string{"Cliente", "Comercial", "Etapa", "Proposta", "Última atividade", "Ações"}, len(items), "Nenhuma negociação encontrada.") {
				for _, item := range items {
					<tr class={ PipelineRowClass(item) } data-admin-list-row data-search={ PipelineSearch(item) } data-filter-stage={ PipelineStage(item) } data-filter-commercial={ item.CommercialName }>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Comercial">{ item.CommercialName }</td>
						<td data-label="Etapa">
							<span class={ PipelineStageBadgeClass(item) }>{ PipelineStage(item) }</span>
							if PipelineIsSigned(item) && item.FullySignedAt != nil {
								<small class="pipeline-list-signed-meta"><span class="pipeline-list-signed-dot" aria-hidden="true"></span> Contrato assinado em { item.FullySignedAt.Format("02/01/2006 15:04") }</small>
							}
						</td>
						<td data-label="Proposta">{ item.ProposalTitle }</td>
						<td data-label="Última atividade">{ item.UpdatedAt.Format("02/01/2006 15:04") }</td>
						<td data-label="Ações" data-actions="true"><div class="admin-list-actions"><a class="btn" href={ templ.SafeURL("/admin/pipeline/" + item.ProposalID) }>Detalhes</a></div></td>
					</tr>
				}
			}
		</div>
	}
}

templ PipelineDetailPage(user domain.User, item domain.PipelineItem, events []domain.PipelineEvent) {
	@AdminLayout("ViaGate — Negociação", user) {
		<link rel="stylesheet" href="/assets/pipeline-timeline.css"/>
		<header class="header"><div><span class="step-title">NEGOCIAÇÃO</span><h1>{ item.ClientName }</h1><p>{ item.ProposalTitle } · responsável comercial: { item.CommercialName }</p></div><div class="actions"><a class="btn" href="/admin/pipeline">Voltar</a><a class="btn dark" href={ templ.SafeURL("/admin/proposals/" + item.ProposalID + "/edit") }>Abrir proposta</a></div></header>
		<section class="panel pipeline-current-panel">
			<div class="panel-head"><h2>Etapa atual</h2><span class={ PipelineStageBadgeClass(item) }>{ PipelineStage(item) }</span></div>
			<div class="panel-body">
				<div class={ PipelineCurrentCardClass(item) }>
					<div class="pipeline-current-main">
						<div>
							<span class="pipeline-current-label">{ PipelineCurrentLabel(item) }</span>
							<h3>{ PipelineStage(item) }</h3>
							<p>{ PipelineStageDescription(item) }</p>
						</div>
					</div>
					if PipelineIsSigned(item) && item.FullySignedAt != nil {
						<div class="pipeline-signed-highlight">
							<span>CONTRATO ASSINADO</span>
							<strong>{ item.FullySignedAt.Format("02/01/2006 15:04") }</strong>
							<small>Assinado por { PipelineSignedBy(item) }</small>
						</div>
					}
				</div>
				<div class="pipeline-stage" style="margin-top:18px">
					<span>Proposta: { humanStatus(item.ProposalStatus) }</span>
					if item.OnboardingStatus != "" {
						<span>Contratação: { humanStatus(item.OnboardingStatus) }</span>
					}
					if item.ContractStatus != "" {
						<span>Contrato: { humanStatus(item.ContractStatus) }</span>
					}
					if item.ActivationStatus != "" {
						<span>Ativação: { humanStatus(item.ActivationStatus) }</span>
					}
				</div>
				<div class="grid pipeline-date-grid" style="margin-top:18px">
					if item.AcceptedAt != nil {
						<div><small>Proposta aceita</small><strong>{ item.AcceptedAt.Format("02/01/2006 15:04") }</strong></div>
					}
					if item.SubmittedAt != nil {
						<div><small>Dados para contratação enviados</small><strong>{ item.SubmittedAt.Format("02/01/2006 15:04") }</strong></div>
					}
					if item.FullySignedAt != nil {
						<div class="signed"><small>Contrato assinado</small><strong>{ item.FullySignedAt.Format("02/01/2006 15:04") }</strong><span>por { PipelineSignedBy(item) }</span></div>
					}
					if item.ActivationSubmittedAt != nil {
						<div><small>Dados para ativação recebidos</small><strong>{ item.ActivationSubmittedAt.Format("02/01/2006 15:04") }</strong></div>
					}
					if item.ActivatedAt != nil {
						<div class="signed"><small>Operação liberada</small><strong>{ item.ActivatedAt.Format("02/01/2006 15:04") }</strong></div>
					}
				</div>
				if item.ActivationID != "" {
					<div style="margin-top:18px"><a class="btn" href={ templ.SafeURL("/admin/activations/" + item.ActivationID) }>Abrir dados para ativação</a></div>
				}
				if item.ContractID != "" {
					<div style="margin-top:18px;padding-top:18px;border-top:1px solid var(--line)">
						<strong style="display:block;margin-bottom:10px">Documentos da contratação</strong>
						<div class="actions">
							<a class="btn dark" target="_blank" rel="noopener" href={ templ.SafeURL("/admin/contracts/" + item.ContractID + "/document") }>{ PipelineContractDownloadLabel(item) }</a>
							if item.ContractFinalizedAt != nil {
								<a class="btn" target="_blank" rel="noopener" href={ templ.SafeURL("/admin/contracts/" + item.ContractID + "/evidence") }>Relatório técnico da assinatura</a>
								<a class="btn primary" target="_blank" rel="noopener" href={ templ.SafeURL("/admin/contracts/" + item.ContractID + "/package") }>Documentos da assinatura</a>
							}
						</div>
						if PipelineIsSigned(item) && item.ContractFinalizedAt == nil {
							<div class="notice" style="margin-top:12px">Os documentos técnicos da assinatura estão sendo preparados automaticamente. Isso não impede o preenchimento dos dados para ativação.</div>
						}
						@ContractVerificationHelp()
					</div>
				}
			</div>
		</section>
		<section class="panel">
			<div class="panel-head"><div><h2>Histórico da contratação e ativação</h2><small class="pipeline-history-help">Veja o que já foi concluído, quem realizou cada ação e quais etapas ainda faltam.</small></div></div>
			<div class="panel-body pipeline-timeline">
				for _, step := range PipelineTimeline(item, events) {
					<article class={ PipelineTimelineStepClass(step) }>
						<div class="pipeline-timeline-marker">
							if step.Current {
								<span class="pipeline-radar" aria-hidden="true"></span>
							} else if step.Completed {
								<span class="pipeline-timeline-dot completed" aria-hidden="true"></span>
							} else {
								<span class="pipeline-timeline-dot pending" aria-hidden="true"></span>
							}
						</div>
						<div class="pipeline-timeline-content">
							<div class="pipeline-timeline-head">
								<strong>{ step.Title }</strong>
								<span class={ PipelineTimelineStatusClass(step) }>{ PipelineTimelineStatus(step) }</span>
							</div>
							<p>{ step.Description }</p>
							<small>{ PipelineTimelineMeta(step) }</small>
						</div>
					</article>
				}
			</div>
		</section>
	}
}
