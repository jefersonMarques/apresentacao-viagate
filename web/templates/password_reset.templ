package templates

templ PasswordResetRequestPage(message, errorMessage string) {
	@AuthLayout("ViaGate — Recuperar senha") {
		<section class="auth">
			<div class="auth-brand">
				<div class="brand">VIAGATE</div>
				<div><span class="step-title">RECUPERAÇÃO DE ACESSO</span><h1>Redefina sua senha com um link individual.</h1></div>
				<small>ViaGate · Ambiente restrito</small>
			</div>
			<div class="auth-form">
				<form class="auth-card" method="post" action="/forgot-password">
					<span class="step-title">RECUPERAR SENHA</span>
					<h1>Informe seu e-mail</h1>
					<p>Se houver uma conta ativa, enviaremos um link temporário para criar uma nova senha.</p>
					if message != "" {
						<div class="notice" role="status">{ message }</div>
					}
					if errorMessage != "" {
						<div class="notice error" role="alert">{ errorMessage }</div>
					}
					<div class="field"><label>E-mail</label><input name="email" type="email" autocomplete="email" required/></div>
					<div class="actions auth-actions"><button class="btn primary" type="submit">Enviar instruções</button><a class="btn ghost" href="/login">Voltar ao login</a></div>
				</form>
			</div>
		</section>
	}
}

templ PasswordResetFormPage(name, email, token, errorMessage string) {
	@AuthLayout("ViaGate — Nova senha") {
		<section class="auth">
			<div class="auth-brand">
				<div class="brand">VIAGATE</div>
				<div><span class="step-title">NOVA SENHA</span><h1>Crie uma nova senha para sua conta.</h1></div>
				<small>O link é individual e temporário.</small>
			</div>
			<div class="auth-form">
				<form class="auth-card" method="post" action={ templ.SafeURL("/reset-password/" + token) }>
					<span class="step-title">REDEFINIR SENHA</span>
					<h1>{ name }</h1>
					<p>{ email }</p>
					if errorMessage != "" {
						<div class="notice error" role="alert">{ errorMessage }</div>
					}
					<div class="field"><label>Nova senha</label><input name="password" type="password" minlength="10" autocomplete="new-password" required/></div>
					<div class="field auth-field-gap"><label>Confirmar nova senha</label><input name="confirm_password" type="password" minlength="10" autocomplete="new-password" required/></div>
					<div class="actions auth-actions"><button class="btn primary" type="submit">Salvar nova senha</button></div>
				</form>
			</div>
		</section>
	}
}

templ PasswordResetSuccessPage() {
	@AuthLayout("ViaGate — Senha redefinida") {
		<section class="auth">
			<div class="auth-brand"><div class="brand">VIAGATE</div><div><span class="step-title">ACESSO ATUALIZADO</span><h1>Sua senha foi redefinida.</h1></div></div>
			<div class="auth-form"><div class="auth-card"><span class="step-title">CONCLUÍDO</span><h1>Nova senha salva.</h1><p>As sessões anteriores foram encerradas por segurança.</p><div class="actions"><a class="btn primary" href="/login">Entrar</a></div></div></div>
		</section>
	}
}
