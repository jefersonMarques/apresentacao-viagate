package templates

import "fmt"

templ AdminPageHeader(eyebrow, title, description string) {
	<header class="admin-page-header admin-list-page-header">
		<div>
			<span class="eyebrow">{ eyebrow }</span>
			<h1>{ title }</h1>
			if description != "" {
				<p>{ description }</p>
			}
		</div>
		<div class="admin-list-page-actions">
			{ children... }
		</div>
	</header>
}

templ AdminListToolbar(total int, singular, plural string) {
	<div class="admin-list-toolbar">
		<div class="admin-list-filters">
			{ children... }
		</div>
		<div class="admin-list-meta">
			<span>
				<strong data-admin-list-count>{ fmt.Sprintf("%d", total) }</strong>
				<span data-admin-list-noun data-singular={ singular } data-plural={ plural }>{ AdminListNoun(total, singular, plural) }</span>
			</span>
			<button class="admin-list-clear" type="button" data-admin-list-clear hidden>Limpar filtros</button>
		</div>
	</div>
}

templ AdminServerSearchToolbar(action, query, placeholder string, total int, singular, plural string) {
	<form method="get" action={ templ.SafeURL(action) } class="admin-list-toolbar">
		<div class="admin-list-filters">
			<label class="admin-list-control admin-list-search">
				<span>Buscar</span>
				<div class="admin-list-search-field">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
					<input type="search" name="q" value={ query } placeholder={ placeholder } autocomplete="off"/>
				</div>
			</label>
			<button class="btn dark admin-list-submit" type="submit">Buscar</button>
			if query != "" {
				<a class="btn" href={ templ.SafeURL(action) }>Limpar</a>
			}
		</div>
		<div class="admin-list-meta"><span><strong>{ fmt.Sprintf("%d", total) }</strong> { AdminListNoun(total, singular, plural) }</span></div>
	</form>
}

templ AdminListSearch(placeholder string) {
	<label class="admin-list-control admin-list-search">
		<span>Buscar</span>
		<div class="admin-list-search-field">
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
			<input type="search" placeholder={ placeholder } autocomplete="off" data-admin-list-search/>
		</div>
	</label>
}

templ AdminListFilter(label, key string) {
	<label class="admin-list-control">
		<span>{ label }</span>
		<select data-admin-list-filter={ key }>
			{ children... }
		</select>
	</label>
}

templ AdminDataTable(headers []string, total int, emptyMessage string) {
	<section class="admin-list-panel">
		<div class="admin-list-table-wrap">
			<table class="admin-data-table">
				<thead>
					<tr>
						for _, header := range headers {
							<th>{ header }</th>
						}
					</tr>
				</thead>
				<tbody>
					{ children... }
					<tr class="admin-list-empty" data-admin-list-empty hidden?={ total > 0 }>
						<td colspan={ fmt.Sprintf("%d", len(headers)) }>{ emptyMessage }</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
}

templ AdminActionMenu(label string) {
	<div class="admin-action-menu" data-admin-action-menu>
		<button class="admin-action-menu-trigger" type="button" aria-label={ label } title={ label } aria-haspopup="menu" aria-expanded="false" data-admin-action-trigger>
			<span aria-hidden="true">•••</span>
		</button>
		<div class="admin-action-menu-popover" role="menu" data-admin-action-popover hidden>
			{ children... }
		</div>
	</div>
}
