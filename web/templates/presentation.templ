package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/catalog"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
	"github.com/jefersonMarques/apresentacao-viagate/internal/presentations"
)

templ PresentationEditorPage(user domain.User, input presentations.EditorInput, draft presentations.SavedDraft, message, errorMessage string) {
	@AdminLayout("ViaGate — Editar apresentação", user) {
		<link rel="stylesheet" href="/assets/v1-admin-forms.css"/>
		<div class="v1-page">
			<header class="v1-editor-header">
				<div>
					<span class="v1-eyebrow">APRESENTAÇÃO INSTITUCIONAL</span>
					<h1>Gerador de apresentação</h1>
					<p>Personalize a apresentação V1 sem transformar o editor em uma ferramenta de diagramação. Cliente, conteúdo e contato são os únicos ajustes necessários.</p>
				</div>
				<div class="v1-actions">
					<a class="v1-button" href="/admin/presentations">Voltar</a>
					if draft.PublicToken != "" && draft.VersionNumber > 0 {
						<a class="v1-button dark" target="_blank" rel="noopener" href={ templ.SafeURL("/a/" + draft.PublicToken) }>Abrir apresentação</a>
					}
				</div>
			</header>
			if message != "" {
				<div class="v1-message">{ message }</div>
			}
			if errorMessage != "" {
				<div class="v1-message error">{ errorMessage }</div>
			}
			<form method="post" action="/admin/presentations/save">
				<input type="hidden" name="presentation_id" value={ input.PresentationID }/>
				<section class="v1-section">
					<header class="v1-section-head"><div><h2>1. Cliente e material</h2><p>O CNPJ pode preencher a identificação da empresa automaticamente.</p></div></header>
					<div class="v1-section-body">
						<div class="v1-form-grid">
							<div class="v1-field full"><label>Título interno</label><input name="title" value={ input.Title } required/></div>
							<div class="v1-field full">
								<label>CNPJ</label>
								<div class="v1-cnpj-row">
									<input name="client_cnpj" data-mask="cnpj" autocomplete="off" value={ input.ClientCNPJ }/>
									<button class="v1-button dark" type="button" data-cnpj-lookup data-cnpj-field="client_cnpj" data-cnpj-prefix="client_">Buscar dados</button>
									<div class="v1-cnpj-status" data-cnpj-status></div>
								</div>
							</div>
							<div class="v1-field"><label>Razão social</label><input name="client_legal_name" value={ input.ClientLegalName }/></div>
							<div class="v1-field"><label>Nome fantasia</label><input name="client_trade_name" value={ input.ClientTradeName }/></div>
							<div class="v1-field full">
								<label>Logo do cliente</label>
								<div class="v1-upload" data-image-upload="client_logo">
									<input type="hidden" name="client_logo_url" value={ input.ClientLogoURL } data-image-value/>
									<div class="v1-upload-preview">
										<img src={ templ.SafeURL(input.ClientLogoURL) } alt="Prévia do logo" data-image-preview hidden?={ input.ClientLogoURL == "" }/>
										<div class="v1-upload-empty" data-image-empty hidden?={ input.ClientLogoURL != "" }>Logo do cliente</div>
									</div>
									<div class="v1-upload-controls">
										<div class="v1-upload-row">
											<label class="v1-button dark small">Selecionar imagem<input type="file" accept="image/jpeg,image/png,image/webp" data-image-file hidden/></label>
											<button class="v1-button ghost small" type="button" data-image-remove hidden>Remover</button>
										</div>
										<div class="v1-help">JPG, PNG ou WEBP · máximo 2 MB.</div>
										<div class="v1-upload-status" data-image-status></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</section>
				<section class="v1-section">
					<header class="v1-section-head"><div><h2>2. Personalização</h2><p>Controles visuais equivalentes aos usados na V1, sem checkbox solto.</p></div></header>
					<div class="v1-section-body">
						<div class="v1-option-grid">
							<label class="v1-option-card">
								<span class="v1-switch"><input type="checkbox" name="show_client_identity" value="1" checked?={ input.ShowClientIdentity }/><span class="v1-switch-track"></span></span>
								<span><strong>Identificar o cliente na abertura</strong><small>Exibe empresa, contato e logo cadastrados acima.</small></span>
							</label>
							<label class="v1-option-card">
								<span class="v1-switch"><input type="checkbox" name="show_contact_slide" value="1" checked?={ input.ShowContactSlide }/><span class="v1-switch-track"></span></span>
								<span><strong>Exibir contato comercial ao final</strong><small>Usa automaticamente os dados do perfil do comercial responsável.</small></span>
							</label>
						</div>
						<details class="v1-details">
							<summary>Contato de referência do cliente</summary>
							<div class="v1-details-body">
								<div class="v1-form-grid">
									<div class="v1-field"><label>Nome</label><input name="contact_name" value={ input.ContactName }/></div>
									<div class="v1-field"><label>Cargo</label><input name="contact_role" value={ input.ContactRole }/></div>
									<div class="v1-field full"><label>E-mail</label><input name="contact_email" type="email" value={ input.ContactEmail }/></div>
								</div>
							</div>
						</details>
					</div>
				</section>
				<section class="v1-section">
					<header class="v1-section-head"><div><h2>3. Soluções a apresentar</h2><p>Ative apenas os blocos relevantes. A apresentação pública remove os slides específicos dos módulos desmarcados e recalcula a navegação.</p></div></header>
					<div class="v1-section-body">
						<div class="v1-option-grid">
							for _, group := range catalog.Groups {
								<label class="v1-option-card">
									<span class="v1-switch"><input type="checkbox" name="module" value={ group.ID } checked?={ PresentationModuleSelected(input, group.ID) }/><span class="v1-switch-track"></span></span>
									<span><strong>{ group.ShortTitle }</strong><small>{ group.Summary }</small></span>
								</label>
							}
						</div>
					</div>
				</section>
				<div class="v1-editor-footer">
					<span class="v1-version-label">As versões publicadas permanecem imutáveis.</span>
					<div class="v1-actions">
						<button class="v1-button dark" type="submit">Salvar rascunho</button>
						<button class="v1-button primary" type="submit" formaction="/admin/presentations/save?action=publish" data-processing="Publicando apresentação...">Publicar apresentação</button>
					</div>
				</div>
			</form>
		</div>
	}
}

templ PublicPresentationPage(p presentations.PublicPresentation) {
	<!doctype html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#071827"/>
			<meta name="robots" content="noindex,nofollow,noarchive"/>
			<title>ViaGate — { p.Title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/v1-presentation-shell.css"/>
		</head>
		<body class="is-paused">
			<div class="loading" data-v1-presentation-loading>Carregando apresentação...</div>
			<iframe
				class="presentation-frame"
				data-v1-presentation-frame
				data-sales-name={ p.SalespersonName }
				data-sales-role={ p.SalespersonJobTitle }
				data-sales-email={ p.SalespersonEmail }
				data-sales-phone={ Phone(p.SalespersonPhone) }
				data-sales-photo={ p.SalespersonPhotoURL }
				data-sales-linkedin={ p.SalespersonLinkedIn }
				data-sales-instagram={ p.SalespersonInstagram }
				data-show-client={ BoolString(p.ShowClientIdentity) }
				data-client-name={ PresentationClientName(p) }
				data-client-logo={ p.ClientLogoURL }
				data-contact-name={ p.ContactName }
				data-show-contact={ BoolString(p.ShowContactSlide) }
				data-modules={ PresentationModulesCSV(p.SelectedModules) }
				title="Apresentação ViaGate"
				allow="fullscreen"
				hidden
			></iframe>
			<div class="presentation-gate" role="dialog" aria-modal="true" aria-label="Controle da apresentação">
				<div class="presentation-action">
					<div class="presentation-action-row">
						<button class="presentation-button secondary" data-v1-presentation-restart type="button" hidden>VOLTAR AO INÍCIO</button>
						<button class="presentation-button" data-v1-presentation-start type="button">INICIAR APRESENTAÇÃO</button>
					</div>
					<img class="presentation-logo" src="/v1/assets/logo-viagate-white.svg" alt="ViaGate"/>
				</div>
			</div>
			<div class="presentation-navigation" data-v1-presentation-navigation aria-label="Navegação da apresentação" hidden>
				<button data-v1-presentation-previous type="button" aria-label="Slide anterior">↑</button>
				<span data-v1-presentation-counter>01 / 01</span>
				<button data-v1-presentation-next type="button" aria-label="Próximo slide">↓</button>
			</div>
			<script src="/assets/v1-presentation-viewer.js" defer></script>
		</body>
	</html>
}
