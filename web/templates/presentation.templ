package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/catalog"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
	"github.com/jefersonMarques/apresentacao-viagate/internal/presentations"
)

templ PresentationEditorPage(user domain.User, input presentations.EditorInput, draft presentations.SavedDraft, message, errorMessage string) {
	@AdminLayout("ViaGate — Editar apresentação", user) {
		<link rel="stylesheet" href="/assets/v1-admin-forms.css"/>
		<div class="v1-page">
			<header class="v1-editor-header">
				<div>
					<span class="v1-eyebrow">APRESENTAÇÃO INSTITUCIONAL</span>
					<h1>Gerador de apresentação</h1>
					<p>O material visual segue a apresentação V1. Aqui o comercial informa apenas cliente, contato e quais soluções serão destacadas.</p>
				</div>
				<div class="v1-actions">
					<a class="v1-button" href="/admin/presentations">Voltar</a>
					if draft.PublicToken != "" && draft.VersionNumber > 0 {
						<a class="v1-button dark" target="_blank" rel="noopener" href={ templ.SafeURL("/a/" + draft.PublicToken) }>Abrir apresentação</a>
					}
				</div>
			</header>
			if message != "" {
				<div class="v1-message">{ message }</div>
			}
			if errorMessage != "" {
				<div class="v1-message error">{ errorMessage }</div>
			}
			<form method="post" action="/admin/presentations/save">
				<input type="hidden" name="presentation_id" value={ input.PresentationID }/>
				<section class="v1-section">
					<header class="v1-section-head"><div><h2>Cliente e material</h2><p>Personalização aplicada sobre o conteúdo institucional da V1.</p></div></header>
					<div class="v1-section-body">
						<div class="v1-form-grid">
							<div class="v1-field full"><label>Título interno</label><input name="title" value={ input.Title } required/></div>
							<div class="v1-field"><label>Razão social</label><input name="client_legal_name" value={ input.ClientLegalName }/></div>
							<div class="v1-field"><label>Nome fantasia</label><input name="client_trade_name" value={ input.ClientTradeName }/></div>
							<div class="v1-field"><label>CNPJ</label><input name="client_cnpj" data-mask="cnpj" autocomplete="off" value={ input.ClientCNPJ }/></div>
							<div class="v1-field"><label>Personalização</label><label class="v1-condition"><input type="checkbox" name="show_client_identity" value="1" checked?={ input.ShowClientIdentity }/><span>Mostrar o cliente na abertura da apresentação.</span></label></div>
						</div>
					</div>
				</section>
				<section class="v1-section">
					<header class="v1-section-head"><div><h2>Contato do cliente</h2><p>Usado na personalização e no encerramento quando habilitado.</p></div></header>
					<div class="v1-section-body">
						<div class="v1-form-grid">
							<div class="v1-field"><label>Nome</label><input name="contact_name" value={ input.ContactName }/></div>
							<div class="v1-field"><label>Cargo</label><input name="contact_role" value={ input.ContactRole }/></div>
							<div class="v1-field"><label>E-mail</label><input name="contact_email" type="email" value={ input.ContactEmail }/></div>
							<div class="v1-field"><label>Encerramento</label><label class="v1-condition"><input type="checkbox" name="show_contact_slide" value="1" checked?={ input.ShowContactSlide }/><span>Mostrar o slide de contato comercial ao final.</span></label></div>
						</div>
					</div>
				</section>
				<section class="v1-section">
					<header class="v1-section-head"><div><h2>Soluções a apresentar</h2><p>O conteúdo e o design dos slides continuam sendo os da V1.</p></div></header>
					<div class="v1-section-body">
						<div class="v1-model-grid">
							for _, group := range catalog.Groups {
								<label class="v1-model-card">
									<input type="checkbox" name="module" value={ group.ID } checked?={ PresentationModuleSelected(input, group.ID) }/>
									<small>SOLUÇÃO VIAGATE</small>
									<strong>{ group.ShortTitle }</strong>
									<span>{ group.Summary }</span>
								</label>
							}
						</div>
					</div>
				</section>
				<div class="v1-editor-footer">
					<span class="v1-version-label">As versões publicadas permanecem imutáveis.</span>
					<div class="v1-actions">
						<button class="v1-button dark" type="submit" name="action" value="save">Salvar rascunho</button>
						<button class="v1-button primary" type="submit" name="action" value="publish" data-processing="Publicando apresentação...">Publicar apresentação</button>
					</div>
				</div>
			</form>
		</div>
	}
}

templ PublicPresentationPage(p presentations.PublicPresentation) {
	<!doctype html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#071827"/>
			<meta name="robots" content="noindex,nofollow,noarchive"/>
			<title>ViaGate — { p.Title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/v1-presentation-shell.css"/>
		</head>
		<body class="is-paused">
			<div class="loading" data-v1-presentation-loading>Carregando apresentação...</div>
			<iframe
				class="presentation-frame"
				data-v1-presentation-frame
				data-sales-name={ p.SalespersonName }
				data-sales-role={ p.SalespersonJobTitle }
				data-sales-email={ p.SalespersonEmail }
				data-sales-phone={ Phone(p.SalespersonPhone) }
				data-sales-photo={ p.SalespersonPhotoURL }
				data-sales-linkedin={ p.SalespersonLinkedIn }
				data-sales-instagram={ p.SalespersonInstagram }
				data-show-client={ BoolString(p.ShowClientIdentity) }
				data-client-name={ PresentationClientName(p) }
				data-contact-name={ p.ContactName }
				data-show-contact={ BoolString(p.ShowContactSlide) }
				title="Apresentação ViaGate"
				allow="fullscreen"
				hidden
			></iframe>
			<div class="presentation-gate" role="dialog" aria-modal="true" aria-label="Controle da apresentação">
				<div class="presentation-action">
					<div class="presentation-action-row">
						<button class="presentation-button secondary" data-v1-presentation-restart type="button" hidden>VOLTAR AO INÍCIO</button>
						<button class="presentation-button" data-v1-presentation-start type="button">INICIAR APRESENTAÇÃO</button>
					</div>
					<img class="presentation-logo" src="/v1/assets/logo-viagate-white.svg" alt="ViaGate"/>
				</div>
			</div>
			<div class="presentation-navigation" data-v1-presentation-navigation aria-label="Navegação da apresentação" hidden>
				<button data-v1-presentation-previous type="button" aria-label="Slide anterior">↑</button>
				<span data-v1-presentation-counter>01 / 01</span>
				<button data-v1-presentation-next type="button" aria-label="Próximo slide">↓</button>
			</div>
			<script src="/assets/v1-presentation-viewer.js" defer></script>
		</body>
	</html>
}
