package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/contracts"
	"github.com/jefersonMarques/apresentacao-viagate/internal/legaltext"
)

templ SignatureContractPage(access contracts.SignerAccess, token string, message, errorMessage string) {
	@PublicFlowLayout("ViaGate — Assinatura do contrato") {
		<div class="public">
			<main class="proposal-page public-flow-stack">
				@PublicFlowHeader("ASSINATURA ELETRÔNICA", "Contrato para assinatura", "Responsável: " + access.Signer.Name + " · " + access.Signer.Email)
				if access.Signer.Status == "signed" {
					@PublicFlashMessages(message, errorMessage)
				} else {
					@PublicFlashMessages("", errorMessage)
				}
				<article class="document-view signature-document-view">
					<iframe title="Contrato em PDF" src={ templ.SafeURL("/sign/" + token + "/document") } class="signature-document-frame"></iframe>
					<noscript><p class="signature-document-fallback"><a href={ templ.SafeURL("/sign/" + token + "/document") }>Abrir o contrato em PDF</a></p></noscript>
				</article>
				<p class="public-flow-muted">O PDF acima é o próprio arquivo cuja impressão digital fica vinculada à assinatura. Não é uma reprodução separada do contrato.</p>
				if access.Signer.Status != "signed" {
					<section class="accept-box">
						<span class="step-title">CONFIRMAÇÃO DE IDENTIDADE</span>
						<h2>Assinar este documento</h2>
						<p>Enviaremos um código para o e-mail informado no aceite da proposta. Depois da confirmação, sua assinatura ficará vinculada exatamente ao PDF exibido acima.</p>
						<div class="actions signature-otp-actions">
							<form method="post" action={ templ.SafeURL("/sign/" + token + "/otp") }>
								<button class="btn dark" type="submit" data-processing="Enviando código...">Enviar código por e-mail</button>
							</form>
							if message != "" {
								<div class="notice signature-inline-notice">{ message }</div>
							}
						</div>
						<form method="post" action={ templ.SafeURL("/sign/" + token + "/confirm") } class="grid">
							<div class="field">
								<label>Código de 6 dígitos</label>
								<input name="otp" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required/>
							</div>
							<div class="field full">
								<label class="signature-consent">
									<input type="checkbox" name="consent" value="1" required/>
									<span>{ legaltext.SignatureConsentText }</span>
								</label>
							</div>
							<div class="field full">
								<button class="btn primary" type="submit" data-processing="Registrando assinatura...">Assinar contrato</button>
							</div>
						</form>
					</section>
				} else {
					<section class="accept-box">
						<span class="step-title">CONTRATO ASSINADO</span>
						<h2>Assinatura registrada com sucesso.</h2>
						<p>A contratação foi concluída. O próprio PDF contém um QR Code para consultar a autenticidade e conferir o arquivo quando necessário.</p>
						<div class="actions">
							<a class="btn ghost" href={ templ.SafeURL("/sign/" + token + "/contract") }>Baixar contrato assinado</a>
							<form method="post" action={ templ.SafeURL("/sign/" + token + "/activation") }>
								<button class="btn primary" type="submit" data-processing="Preparando próximo passo...">Continuar para dados de ativação</button>
							</form>
						</div>
						<p class="public-flow-muted">Os dados para ativação são uma etapa separada do contrato. Você poderá preencher agora ou encaminhar para alguém da sua equipe.</p>
					</section>
				}
				<section class="accept-box">
					<span class="step-title">SEGURANÇA DO DOCUMENTO</span>
					<h2>Como sabemos que este é o mesmo contrato?</h2>
					<p>Antes da assinatura, a ViaGate gera o PDF final já com o QR Code e cria uma impressão digital única daquele arquivo. Essa impressão digital fica registrada junto ao processo de assinatura.</p>
					<p>No momento da assinatura, a confirmação é vinculada exatamente àquela versão. Depois disso, o arquivo registrado não é alterado.</p>
					<p>Se qualquer parte do PDF for modificada posteriormente, mesmo uma alteração mínima, a impressão digital muda. Ao escanear o QR Code, é possível consultar o registro e também comparar uma cópia do PDF com o documento original.</p>
					<p><strong>O QR Code não é a assinatura.</strong> Ele é o caminho para consultar a verificação mantida pela ViaGate.</p>
					<details class="public-flow-details">
						<summary>Como funciona tecnicamente?</summary>
						<p>A ViaGate calcula uma impressão digital SHA-256 sobre os bytes do PDF final. O valor é registrado antes da assinatura e comparado quando alguém deseja confirmar se outra cópia é exatamente o mesmo arquivo.</p>
					</details>
				</section>
			</main>
		</div>
	}
}
