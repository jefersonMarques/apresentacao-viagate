package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/domain"

templ NotificationsPage(user domain.User, items []domain.InAppNotification) {
	@AdminLayout("ViaGate — Notificações", user) {
		@AdminPageHeader("NOTIFICAÇÕES", "Central de notificações", "Acompanhe eventos importantes dos seus clientes e, quando autorizado, atividades de outros usuários.")
		if len(items) > 0 {
			<form method="post" action="/admin/notifications/read-all" class="admin-notification-read-all">
				<button class="btn" type="submit">Marcar todas como lidas</button>
			</form>
		}
		<section class="panel">
			<div class="panel-body admin-notification-feed">
				for _, item := range items {
					@NotificationFeedItem(item, false)
				}
				if len(items) == 0 {
					<div class="admin-notification-empty">
						<strong>Nenhuma notificação.</strong>
						<span>Eventos importantes aparecerão aqui.</span>
					</div>
				}
			</div>
		</section>
	}
}

templ NotificationPopover(items []domain.InAppNotification) {
	<section class="notification-popover-card" aria-label="Notificações recentes">
		<header class="notification-popover-header">
			<div><small>ATIVIDADE</small><strong>Notificações</strong></div>
			<span>{ NotificationUnreadLabel(items) }</span>
		</header>
		<div class="notification-popover-feed">
			for _, item := range items {
				@NotificationFeedItem(item, true)
			}
			if len(items) == 0 {
				<div class="admin-notification-empty"><strong>Nenhuma notificação.</strong><span>Novos eventos aparecerão aqui.</span></div>
			}
		</div>
		<a class="notification-popover-all" href="/admin/notifications">Ver todas as notificações <span>→</span></a>
	</section>
}

templ NotificationFeedItem(item domain.InAppNotification, compact bool) {
	<article class={ NotificationRowClass(item) + NotificationCompactClass(compact) }>
		<div class="admin-notification-dot" aria-hidden="true"></div>
		<div class="admin-notification-copy">
			<strong>{ item.Title }</strong>
			if item.Body != "" {
				<span>{ item.Body }</span>
			}
			<small>{ NotificationTime(item.CreatedAt) }</small>
		</div>
		if !compact {
			<div class="admin-notification-actions">
				if item.TargetURL != "" {
					<form method="post" action={ templ.SafeURL("/admin/notifications/" + item.ID + "/open") }>
						<input type="hidden" name="target" value={ item.TargetURL }/>
						<button class="btn" type="submit">Abrir</button>
					</form>
				} else if item.ReadAt == nil {
					<form method="post" action={ templ.SafeURL("/admin/notifications/" + item.ID + "/read") }>
						<button class="btn" type="submit">Marcar como lida</button>
					</form>
				}
			</div>
		} else if item.TargetURL != "" {
			<form class="notification-popover-open" method="post" action={ templ.SafeURL("/admin/notifications/" + item.ID + "/open") }>
				<input type="hidden" name="target" value={ item.TargetURL }/>
				<button type="submit" aria-label="Abrir notificação">→</button>
			</form>
		}
	</article>
}
