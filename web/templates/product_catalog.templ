package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/catalog"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
)

templ ProductCatalogPage(user domain.User, categories []catalog.ManagedCategory, showHidden bool, message, errorMessage string) {
	@AdminLayout("ViaGate — Produtos", user) {
		<link rel="stylesheet" href="/commercial-assets/product-catalog.css"/>
		@AdminPageHeader("CATÁLOGO COMERCIAL", "Produtos", "Organize categorias, produtos e dependências usadas na composição das propostas.") {
			<button class="btn" type="button" data-catalog-dialog-open="new-category">Nova categoria</button>
			if CatalogHasWritableCategory(categories) {
				<button class="btn primary" type="button" data-catalog-dialog-open="new-product">Novo produto</button>
			}
		}
		@FlashMessages(message, errorMessage)

		<section class="catalog-list">
			<div class="catalog-section-head">
				<div>
					<span class="eyebrow">ESTRUTURA DO CATÁLOGO</span>
					<h2>Categorias</h2>
					<p>Arquivados e excluídos ficam ocultos por padrão e podem ser consultados usando o filtro.</p>
				</div>
				<form method="get" action="/admin/products" class="catalog-filter">
					<label>
						<input type="checkbox" name="show_hidden" value="1" checked?={ showHidden }/>
						<span>Mostrar arquivados e excluídos</span>
					</label>
					<button class="btn" type="submit">Aplicar</button>
				</form>
			</div>

			if len(categories) == 0 {
				<div class="catalog-empty">
					<strong>Nenhuma categoria encontrada.</strong>
					<span>Crie uma categoria ou altere o filtro atual.</span>
				</div>
			} else {
				<div class="catalog-category-list">
					for _, category := range categories {
						<details class={ "catalog-category " + CatalogLifecycleClass(category.IsActive, category.IsArchived, category.IsDeleted) }>
							<summary class="catalog-category-summary">
								<div class="catalog-category-main">
									<span class={ "catalog-status " + CatalogLifecycleClass(category.IsActive, category.IsArchived, category.IsDeleted) }>
										{ CatalogLifecycleLabel(category.IsActive, category.IsArchived, category.IsDeleted) }
									</span>
									<div class="catalog-category-copy">
										<strong>{ category.Name }</strong>
										if category.Description != "" {
											<small>{ category.Description }</small>
										}
									</div>
								</div>
								<div class="catalog-category-meta">
									<span>{ CatalogNonDeletedProductCount(category) } produto(s)</span>
									<span class="catalog-chevron" aria-hidden="true">
										<svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg>
									</span>
								</div>
							</summary>

							<div class="catalog-category-body">
								<div class="catalog-category-toolbar">
									<div>
										<small>CÓDIGO</small>
										<code>{ category.Code }</code>
									</div>
									<div class="catalog-toolbar-actions">
										if category.IsDeleted {
											<form method="post" action={ templ.SafeURL("/admin/products/categories/" + category.ID + "/lifecycle") }>
												<input type="hidden" name="action" value="restore"/>
												<input type="hidden" name="show_hidden" value="1"/>
												<button class="btn" type="submit">Restaurar categoria</button>
											</form>
										} else if category.IsArchived {
											<form method="post" action={ templ.SafeURL("/admin/products/categories/" + category.ID + "/lifecycle") }>
												<input type="hidden" name="action" value="unarchive"/>
												<input type="hidden" name="show_hidden" value="1"/>
												<button class="btn" type="submit">Reativar categoria</button>
											</form>
										} else {
											<button class="btn" type="button" data-catalog-dialog-open={ "category-" + category.ID }>Editar categoria</button>
											<button class="btn primary" type="button" data-catalog-new-product-category={ category.ID }>Adicionar produto</button>
											<form
												method="post"
												action={ templ.SafeURL("/admin/products/categories/" + category.ID + "/lifecycle") }
												data-catalog-delete-form
												data-delete-title="Excluir categoria"
												data-delete-name={ category.Name }
												data-delete-message="O sistema tentará excluir a categoria. Se ela já estiver em uso ou ainda possuir produtos, será arquivada automaticamente."
											>
												<input type="hidden" name="action" value="delete"/>
												if showHidden {
													<input type="hidden" name="show_hidden" value="1"/>
												}
												<button class="btn danger" type="button" data-catalog-delete-open>Excluir</button>
											</form>
										}
									</div>
								</div>

								if len(category.Products) == 0 {
									<div class="catalog-empty compact">
										<strong>Nenhum produto nesta categoria.</strong>
										if !category.IsDeleted && !category.IsArchived {
											<span>Use “Adicionar produto” para cadastrar o primeiro item.</span>
										}
									</div>
								} else {
									<div class="catalog-product-table" role="table" aria-label={ "Produtos de " + category.Name }>
										<div class="catalog-product-row catalog-product-header" role="row">
											<span role="columnheader">Produto</span>
											<span role="columnheader">Dependências</span>
											<span role="columnheader">Unidade</span>
											<span role="columnheader">Status</span>
											<span role="columnheader"></span>
										</div>
										for _, product := range category.Products {
											<div class={ "catalog-product-row " + CatalogLifecycleClass(product.IsActive, product.IsArchived, product.IsDeleted) } role="row">
												<div class="catalog-product-name" role="cell">
													<strong>{ product.Name }</strong>
													if product.Description != "" {
														<small>{ product.Description }</small>
													}
												</div>
												<div class="catalog-product-dependency-summary" role="cell">
													if CatalogDependencyCount(product) > 0 {
														<strong>{ CatalogDependencyCount(product) } grupo(s)</strong>
														<small>{ CatalogDependencySummary(product.DependencyGroups) }</small>
													} else {
														<span>Sem dependências</span>
													}
												</div>
												<span role="cell">{ CatalogValueOrDash(product.Unit) }</span>
												<span role="cell">
													<span class={ "catalog-status " + CatalogLifecycleClass(product.IsActive, product.IsArchived, product.IsDeleted) }>
														{ CatalogLifecycleLabel(product.IsActive, product.IsArchived, product.IsDeleted) }
													</span>
												</span>
												<div class="catalog-product-actions" role="cell">
													if product.IsDeleted {
														<form method="post" action={ templ.SafeURL("/admin/products/items/" + product.ID + "/lifecycle") }>
															<input type="hidden" name="action" value="restore"/>
															<input type="hidden" name="show_hidden" value="1"/>
															<button class="btn" type="submit">Restaurar</button>
														</form>
													} else if product.IsArchived {
														<form method="post" action={ templ.SafeURL("/admin/products/items/" + product.ID + "/lifecycle") }>
															<input type="hidden" name="action" value="unarchive"/>
															<input type="hidden" name="show_hidden" value="1"/>
															<button class="btn" type="submit">Reativar</button>
														</form>
													} else {
														<button class="btn" type="button" data-catalog-dialog-open={ "product-" + product.ID }>Editar</button>
														<form
															method="post"
															action={ templ.SafeURL("/admin/products/items/" + product.ID + "/lifecycle") }
															data-catalog-delete-form
															data-delete-title="Excluir produto"
															data-delete-name={ product.Name }
															data-delete-message="O sistema tentará excluir o produto. Se ele já estiver em uso ou for requisito de outro produto, será arquivado automaticamente."
														>
															<input type="hidden" name="action" value="delete"/>
															if showHidden {
																<input type="hidden" name="show_hidden" value="1"/>
															}
															<button class="btn danger" type="button" data-catalog-delete-open>Excluir</button>
														</form>
													}
												</div>
											</div>
										}
									</div>
								}
							</div>
						</details>
					}
				</div>
			}
		</section>

		<dialog class="catalog-dialog" data-catalog-dialog="new-category" aria-labelledby="catalog-new-category-title">
			<div class="catalog-dialog-card">
				<header class="catalog-dialog-head">
					<div>
						<span class="eyebrow">NOVA CATEGORIA</span>
						<h2 id="catalog-new-category-title">Criar categoria</h2>
					</div>
					<button class="catalog-dialog-close" type="button" data-catalog-dialog-close aria-label="Fechar">×</button>
				</header>
				<form method="post" action="/admin/products/categories" class="catalog-dialog-form">
					@CatalogCategoryFields("", "", "", true, 0)
					<footer class="catalog-dialog-footer">
						<button class="btn" type="button" data-catalog-dialog-close>Cancelar</button>
						<button class="btn primary" type="submit">Criar categoria</button>
					</footer>
				</form>
			</div>
		</dialog>

		if CatalogHasWritableCategory(categories) {
			<dialog class="catalog-dialog" data-catalog-dialog="new-product" aria-labelledby="catalog-new-product-title">
				<div class="catalog-dialog-card">
					<header class="catalog-dialog-head">
						<div>
							<span class="eyebrow">NOVO PRODUTO</span>
							<h2 id="catalog-new-product-title">Criar produto</h2>
						</div>
						<button class="catalog-dialog-close" type="button" data-catalog-dialog-close aria-label="Fechar">×</button>
					</header>
					<form method="post" action="/admin/products/items" class="catalog-dialog-form">
						@CatalogProductFields(categories, catalog.ManagedProduct{IsActive: true})
						<footer class="catalog-dialog-footer">
							<button class="btn" type="button" data-catalog-dialog-close>Cancelar</button>
							<button class="btn primary" type="submit">Criar produto</button>
						</footer>
					</form>
				</div>
			</dialog>
		}

		for _, category := range categories {
			if !category.IsDeleted {
				<dialog class="catalog-dialog" data-catalog-dialog={ "category-" + category.ID } aria-label={ "Editar " + category.Name }>
					<div class="catalog-dialog-card">
						<header class="catalog-dialog-head">
							<div>
								<span class="eyebrow">EDITAR CATEGORIA</span>
								<h2>{ category.Name }</h2>
							</div>
							<button class="catalog-dialog-close" type="button" data-catalog-dialog-close aria-label="Fechar">×</button>
						</header>
						<form method="post" action="/admin/products/categories" class="catalog-dialog-form">
							<input type="hidden" name="id" value={ category.ID }/>
							@CatalogCategoryFields(category.Name, category.Description, category.Code, category.IsActive, category.SortOrder)
							<footer class="catalog-dialog-footer">
								<button class="btn" type="button" data-catalog-dialog-close>Cancelar</button>
								<button class="btn primary" type="submit">Salvar categoria</button>
							</footer>
						</form>
					</div>
				</dialog>
			}

			for _, product := range category.Products {
				if !product.IsDeleted {
					<dialog class="catalog-dialog catalog-dialog-wide" data-catalog-dialog={ "product-" + product.ID } aria-label={ "Editar " + product.Name }>
						<div class="catalog-dialog-card">
							<header class="catalog-dialog-head">
								<div>
									<span class="eyebrow">EDITAR PRODUTO</span>
									<h2>{ product.Name }</h2>
								</div>
								<button class="catalog-dialog-close" type="button" data-catalog-dialog-close aria-label="Fechar">×</button>
							</header>
							<form method="post" action="/admin/products/items" class="catalog-dialog-form">
								<input type="hidden" name="id" value={ product.ID }/>
								@CatalogProductFields(categories, product)
								<footer class="catalog-dialog-footer">
									<button class="btn" type="button" data-catalog-dialog-close>Cancelar</button>
									<button class="btn primary" type="submit">Salvar produto</button>
								</footer>
							</form>
						</div>
					</dialog>
				}
			}
		}

		<dialog class="catalog-dialog catalog-delete-dialog" data-catalog-delete-dialog aria-labelledby="catalog-delete-title">
			<div class="catalog-dialog-card catalog-delete-card">
				<header class="catalog-dialog-head catalog-delete-head">
					<div class="catalog-delete-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Z"/><path d="M12 9v4"/><path d="M12 16h.01"/></svg>
					</div>
					<div class="catalog-delete-heading">
						<span class="eyebrow">CONFIRMAR EXCLUSÃO</span>
						<h2 id="catalog-delete-title" data-catalog-delete-title>Excluir item</h2>
					</div>
					<button class="catalog-dialog-close" type="button" data-catalog-delete-close aria-label="Fechar">×</button>
				</header>
				<div class="catalog-delete-body">
					<strong data-catalog-delete-name></strong>
					<p data-catalog-delete-message></p>
					<div class="catalog-delete-warning">
						<strong>Esta ação não apaga o histórico.</strong>
						<span>Se o item puder ser excluído, a exclusão será lógica. Se já estiver em uso, ele será arquivado automaticamente. Ambos poderão ser consultados pelo filtro “Mostrar arquivados e excluídos”.</span>
					</div>
				</div>
				<footer class="catalog-dialog-footer catalog-delete-footer">
					<button class="btn" type="button" data-catalog-delete-close>Cancelar</button>
					<button class="btn danger" type="button" data-catalog-delete-confirm>Excluir</button>
				</footer>
			</div>
		</dialog>

		<script src="/commercial-assets/product-catalog.js" defer></script>
	}
}

templ CatalogCategoryFields(name, description, code string, active bool, sortOrder int) {
	<div class="catalog-form-grid">
		<label class="full">
			<span>Nome</span>
			<input name="name" value={ name } required placeholder="Ex.: Cargo Score"/>
		</label>
		if code != "" {
			<label class="full">
				<span>Código interno</span>
				<input value={ code } readonly/>
				<small>O código é estável para preservar referências históricas.</small>
			</label>
		}
		<label class="full">
			<span>Descrição</span>
			<textarea name="description" rows="3" placeholder="Explique resumidamente o que esta categoria reúne.">{ description }</textarea>
		</label>
		<label>
			<span>Ordem</span>
			<input name="sort_order" type="number" value={ CatalogSortOrder(sortOrder) }/>
		</label>
		<label class="catalog-check">
			<input type="checkbox" name="is_active" value="1" checked?={ active }/>
			<span>Categoria ativa</span>
		</label>
	</div>
}

templ CatalogProductFields(categories []catalog.ManagedCategory, product catalog.ManagedProduct) {
	<div class="catalog-form-grid">
		<label>
			<span>Categoria</span>
			<select name="category_id" required data-catalog-product-category>
				for _, category := range categories {
					if !category.IsDeleted && (!category.IsArchived || category.ID == product.CategoryID) {
						<option value={ category.ID } selected?={ category.ID == product.CategoryID }>{ category.Name }</option>
					}
				}
			</select>
		</label>
		<label>
			<span>Unidade</span>
			<input name="unit" value={ product.Unit } placeholder="consulta, veículo, viagem..."/>
		</label>
		<label class="full">
			<span>Nome</span>
			<input name="name" value={ product.Name } required placeholder="Ex.: Consulta | Motorista"/>
		</label>
		<label class="full">
			<span>Descrição</span>
			<textarea name="description" rows="3" placeholder="Opcional">{ product.Description }</textarea>
		</label>
		<label>
			<span>Ordem</span>
			<input name="sort_order" type="number" value={ CatalogSortOrder(product.SortOrder) }/>
		</label>
		<label class="catalog-check">
			<input type="checkbox" name="is_active" value="1" checked?={ product.IsActive }/>
			<span>Produto ativo</span>
		</label>
	</div>

	<details class="catalog-dependencies" open?={ len(product.DependencyGroups) > 0 }>
		<summary>
			<span>Dependências</span>
			if len(product.DependencyGroups) > 0 {
				<small>{ CatalogDependencySummary(product.DependencyGroups) }</small>
			} else {
				<small>Sem condicionais configuradas.</small>
			}
		</summary>
		<div class="catalog-dependencies-body">
			<p>Todos os grupos precisam ser atendidos. Dentro de cada grupo você escolhe se basta qualquer produto ou se todos são obrigatórios.</p>
			<div class="catalog-dependency-groups" data-dependency-groups data-next-index={ CatalogSortOrder(len(product.DependencyGroups)) }>
				for index, group := range product.DependencyGroups {
					@CatalogDependencyGroup(categories, product, group, index)
				}
			</div>
			<button class="btn" type="button" data-add-dependency-group>Adicionar grupo de condições</button>
			<template data-dependency-group-template>
				@CatalogDependencyGroupTemplate(categories, product)
			</template>
		</div>
	</details>
}

templ CatalogDependencyGroup(categories []catalog.ManagedCategory, product catalog.ManagedProduct, group catalog.DependencyGroup, index int) {
	<div class="catalog-dependency-group" data-dependency-group>
		<div class="catalog-dependency-group-head">
			<strong>Grupo de condição</strong>
			<button class="catalog-remove-dependency" type="button" data-remove-dependency-group aria-label="Remover grupo">×</button>
		</div>
		<div class="catalog-dependency-grid">
			<label>
				<span>Regra</span>
				<select name={ CatalogDependencyModeName(index) }>
					<option value="any" selected?={ group.MatchMode == "any" }>Qualquer um</option>
					<option value="all" selected?={ group.MatchMode == "all" }>Todos</option>
				</select>
			</label>
			<label>
				<span>Produtos necessários</span>
				<select name={ CatalogDependencyProductName(index) } multiple size="6">
					for _, category := range categories {
						if !category.IsDeleted {
							<optgroup label={ category.Name }>
								for _, candidate := range category.Products {
									if candidate.ID != product.ID && !candidate.IsDeleted {
										<option
											value={ candidate.ID }
											selected?={ CatalogDependencySelected(group, candidate.ID) }
											disabled?={ CatalogDependencyCandidateDisabled(category, candidate, CatalogDependencySelected(group, candidate.ID)) }
										>
											{ candidate.Name }{ CatalogDependencyStatusSuffix(candidate) }
										</option>
									}
								}
							</optgroup>
						}
					}
				</select>
				<small>Use Ctrl/Cmd para selecionar mais de um produto.</small>
			</label>
		</div>
	</div>
}

templ CatalogDependencyGroupTemplate(categories []catalog.ManagedCategory, product catalog.ManagedProduct) {
	<div class="catalog-dependency-group" data-dependency-group>
		<div class="catalog-dependency-group-head">
			<strong>Grupo de condição</strong>
			<button class="catalog-remove-dependency" type="button" data-remove-dependency-group aria-label="Remover grupo">×</button>
		</div>
		<div class="catalog-dependency-grid">
			<label>
				<span>Regra</span>
				<select data-dependency-mode-template>
					<option value="any">Qualquer um</option>
					<option value="all">Todos</option>
				</select>
			</label>
			<label>
				<span>Produtos necessários</span>
				<select multiple size="6" data-dependency-products-template>
					for _, category := range categories {
						if !category.IsDeleted && !category.IsArchived {
							<optgroup label={ category.Name }>
								for _, candidate := range category.Products {
									if candidate.ID != product.ID && !candidate.IsDeleted && candidate.IsActive && !candidate.IsArchived {
										<option value={ candidate.ID }>{ candidate.Name }</option>
									}
								}
							</optgroup>
						}
					}
				</select>
				<small>Use Ctrl/Cmd para selecionar mais de um produto.</small>
			</label>
		</div>
	</div>
}
