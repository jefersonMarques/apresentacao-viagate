package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/catalog"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
)

templ ProductCatalogPage(user domain.User, categories []catalog.ManagedCategory, message, errorMessage string) {
	@AdminLayout("ViaGate — Produtos", user) {
		<link rel="stylesheet" href="/commercial-assets/product-catalog.css"/>
		@AdminPageHeader("CATÁLOGO COMERCIAL", "Produtos", "Cadastre categorias e produtos usados na composição das propostas. Itens inativos deixam de aparecer em novas propostas, sem alterar versões antigas.") {
		}
		@FlashMessages(message, errorMessage)

		<div class="catalog-admin-layout">
			<section class="catalog-create-card">
				<div class="catalog-create-head">
					<span class="eyebrow">NOVA CATEGORIA</span>
					<h2>Criar categoria</h2>
				</div>
				<form method="post" action="/admin/products/categories" class="catalog-form">
					<label>
						<span>Nome</span>
						<input name="name" required placeholder="Ex.: Cargo Score"/>
					</label>
					<label>
						<span>Descrição</span>
						<textarea name="description" rows="3" placeholder="Explique resumidamente o que esta categoria reúne."></textarea>
					</label>
					<div class="catalog-form-row">
						<label>
							<span>Ordem</span>
							<input name="sort_order" type="number" value="0"/>
						</label>
						<label class="catalog-check">
							<input type="checkbox" name="is_active" value="1" checked/>
							<span>Categoria ativa</span>
						</label>
					</div>
					<button class="btn primary" type="submit">Criar categoria</button>
				</form>
			</section>

			<section class="catalog-create-card">
				<div class="catalog-create-head">
					<span class="eyebrow">NOVO PRODUTO</span>
					<h2>Criar produto</h2>
				</div>
				if len(categories) > 0 {
					<form method="post" action="/admin/products/items" class="catalog-form">
						<label>
							<span>Categoria</span>
							<select name="category_id" required>
								for _, category := range categories {
									<option value={ category.ID }>{ category.Name }</option>
								}
							</select>
						</label>
						<label>
							<span>Nome</span>
							<input name="name" required placeholder="Ex.: Consulta | Motorista"/>
						</label>
						<label>
							<span>Descrição</span>
							<textarea name="description" rows="2" placeholder="Opcional"></textarea>
						</label>
						<div class="catalog-form-row">
							<label>
								<span>Unidade</span>
								<input name="unit" placeholder="consulta, veículo, viagem..."/>
							</label>
							<label>
								<span>Ordem</span>
								<input name="sort_order" type="number" value="0"/>
							</label>
						</div>
						<label class="catalog-check">
							<input type="checkbox" name="is_active" value="1" checked/>
							<span>Produto ativo</span>
						</label>
						<button class="btn primary" type="submit">Criar produto</button>
					</form>
				} else {
					<div class="catalog-empty">Crie uma categoria antes de cadastrar produtos.</div>
				}
			</section>
		</div>

		<section class="catalog-list">
			<div class="catalog-section-head">
				<div>
					<span class="eyebrow">ESTRUTURA DO CATÁLOGO</span>
					<h2>Categorias e produtos</h2>
				</div>
				<span>{ len(categories) } categoria(s)</span>
			</div>

			if len(categories) == 0 {
				<div class="catalog-empty">Nenhuma categoria cadastrada.</div>
			} else {
				for _, category := range categories {
					<article class="catalog-category">
						<form method="post" action="/admin/products/categories" class="catalog-category-form">
							<input type="hidden" name="id" value={ category.ID }/>
							<div class="catalog-category-title">
								<div>
									<span class={ "catalog-status " + CatalogActiveClass(category.IsActive) }>{ CatalogActiveLabel(category.IsActive) }</span>
									<strong>{ category.Name }</strong>
									<small>{ category.Code }</small>
								</div>
								<button class="btn" type="submit">Salvar categoria</button>
							</div>
							<div class="catalog-edit-grid">
								<label><span>Nome</span><input name="name" value={ category.Name } required/></label>
								<label><span>Ordem</span><input name="sort_order" type="number" value={ CatalogSortOrder(category.SortOrder) }/></label>
								<label class="full"><span>Descrição</span><textarea name="description" rows="2">{ category.Description }</textarea></label>
								<label class="catalog-check full"><input type="checkbox" name="is_active" value="1" checked?={ category.IsActive }/><span>Categoria ativa</span></label>
							</div>
						</form>

						<div class="catalog-products">
							if len(category.Products) == 0 {
								<div class="catalog-empty compact">Nenhum produto nesta categoria.</div>
							} else {
								for _, product := range category.Products {
									<form method="post" action="/admin/products/items" class="catalog-product">
										<input type="hidden" name="id" value={ product.ID }/>
										<div class="catalog-product-summary">
											<div>
												<span class={ "catalog-status " + CatalogActiveClass(product.IsActive) }>{ CatalogActiveLabel(product.IsActive) }</span>
												<strong>{ product.Name }</strong>
												<small>{ product.Code }</small>
											</div>
											<button class="btn" type="submit">Salvar</button>
										</div>
										<div class="catalog-edit-grid product">
											<label>
												<span>Categoria</span>
												<select name="category_id" required>
													for _, option := range categories {
														<option value={ option.ID } selected?={ option.ID == product.CategoryID }>{ option.Name }</option>
													}
												</select>
											</label>
											<label><span>Nome</span><input name="name" value={ product.Name } required/></label>
											<label><span>Unidade</span><input name="unit" value={ product.Unit }/></label>
											<label><span>Ordem</span><input name="sort_order" type="number" value={ CatalogSortOrder(product.SortOrder) }/></label>
											<label class="full"><span>Descrição</span><textarea name="description" rows="2">{ product.Description }</textarea></label>
											<label class="catalog-check full"><input type="checkbox" name="is_active" value="1" checked?={ product.IsActive }/><span>Produto ativo</span></label>
										</div>
									</form>
								}
							}
						</div>
					</article>
				}
			}
		</section>
	}
}
