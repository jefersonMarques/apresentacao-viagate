package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/postsale"

templ PostSaleContactPage(token string, contact postsale.Contact, message, errorMessage string) {
    @PublicFlowLayout("ViaGate — Contato para implantação") {
        <link rel="stylesheet" href="/commercial-assets/signature.css"/>
        <main class="shell public-flow-stack implementation-contact-page">
            <section class="accept-box signature-complete-box implementation-contact-card">
                <span class="badge success" role="status">✓ Contrato assinado com sucesso</span>
                @PublicFlowHeader("PRÓXIMO PASSO", "Quem cuida da implantação?", "Nossa equipe entrará em contato com a pessoa responsável.")
                @PublicFlashMessages(message, errorMessage)

                <form method="post" action={ templ.SafeURL("/sign/" + token + "/contact") } data-implementation-contact-form>
                    <fieldset class="implementation-contact-options">
                        <legend>Contato para implantação</legend>
                        <div class="grid implementation-contact-choices">
                            <label class="implementation-contact-choice">
                                <input type="radio" name="contact_mode" value="self" checked?={ contact.Mode != "team" }/>
                                <span>
                                    <strong>Eu mesmo</strong>
                                    <small>Usar meus dados já informados.</small>
                                </span>
                            </label>
                            <label class="implementation-contact-choice">
                                <input type="radio" name="contact_mode" value="team" checked?={ contact.Mode == "team" } aria-controls="implementation-team-fields"/>
                                <span>
                                    <strong>Minha equipe</strong>
                                    <small>Informar outra pessoa responsável.</small>
                                </span>
                            </label>
                        </div>
                    </fieldset>

                    <div class="grid implementation-contact-team" id="implementation-team-fields" data-implementation-team-fields hidden?={ contact.Mode != "team" }>
                        <div class="field">
                            <label for="implementation-contact-name">Nome</label>
                            <input id="implementation-contact-name" name="contact_name" value={ TeamContactValue(contact.Mode, contact.Name) } autocomplete="name" required?={ contact.Mode == "team" }/>
                        </div>
                        <div class="field">
                            <label for="implementation-contact-phone">Telefone</label>
                            <input id="implementation-contact-phone" name="contact_phone" type="tel" value={ TeamContactValue(contact.Mode, contact.Phone) } autocomplete="tel" data-mask="phone" required?={ contact.Mode == "team" }/>
                        </div>
                        <div class="field full">
                            <label for="implementation-contact-email">E-mail (opcional)</label>
                            <input id="implementation-contact-email" name="contact_email" value={ TeamContactValue(contact.Mode, contact.Email) } type="email" autocomplete="email"/>
                        </div>
                    </div>

                    <div class="actions implementation-contact-actions">
                        <button class="btn primary" type="submit" data-processing="Salvando contato...">Confirmar contato</button>
                        <a class="btn ghost" href={ templ.SafeURL("/sign/" + token + "/contract") }>Baixar contrato assinado</a>
                    </div>
                </form>
            </section>
        </main>
        <script src="/commercial-assets/implementation-contact.js" defer></script>
    }
}
