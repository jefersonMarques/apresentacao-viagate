package templates

import (
    "fmt"

    "github.com/jefersonMarques/apresentacao-viagate/internal/activation"
    "github.com/jefersonMarques/apresentacao-viagate/internal/domain"
    "github.com/jefersonMarques/apresentacao-viagate/internal/platform/brfields"
)

templ ActivationPage(access activation.Access, token, message, errorMessage string) {
    @PublicFlowLayout("ViaGate — Dados para implantação") {
        <link rel="stylesheet" href="/commercial-assets/activation.css"/>
        <link rel="stylesheet" href="/commercial-assets/activation-public.css"/>
        <div class="public activation-public">
            <main class="proposal-page activation-page" data-activation-access-section={ access.Section } data-activation-wizard>
                <header class="activation-hero">
                    <span class="step-title">IMPLANTAÇÃO VIAGATE</span>
                    <h1>Vamos preparar sua implantação.</h1>
                    if access.Section == "all" {
                        <p>Preencha uma etapa por vez. Revise os dados antes de confirmar.</p>
                    } else {
                        <p>Você foi indicado para completar esta etapa. Preencha os dados e salve.</p>
                    }
                    <div class="activation-status-line"><strong>{ access.Profile.LegalName }</strong></div>
                </header>

                @PublicFlashMessages(message, errorMessage)

                if ActivationFinished(access.Profile) {
                    <section class="accept-box activation-complete-box activation-wizard-success" role="status">
                        <span class="activation-success-mark" aria-hidden="true">✓</span>
                        <span class="step-title">DADOS RECEBIDOS</span>
                        <h2>Dados enviados com sucesso!</h2>
                        <p>Recebemos suas informações. O comercial cuidará dos dados operacionais e nossa equipe dará continuidade à implantação.</p>
                        if !ActivationContractSigned(access.Profile) {
                            <p>A implantação interna permanece aguardando a assinatura do contrato.</p>
                        }
                    </section>
                }
                if !ActivationFinished(access.Profile) {
                    <div class="activation-step-summary" aria-live="polite">
                        <strong data-activation-step-count>Etapa</strong>
                        <span data-activation-step-label>Preparação</span>
                    </div>
                    <nav class="activation-progress" aria-label="Etapas da preparação">
                        for index, step := range ActivationSteps(access) {
                            <button
                                class={ "activation-progress-item " + activationDoneClass(step.Complete) }
                                type="button"
                                data-activation-step-link={ step.Key }
                                data-activation-complete={ BoolString(step.Complete) }
                            >
                                <span class="activation-progress-number" aria-hidden="true">{ fmt.Sprint(index + 1) }</span>
                                <strong>{ step.Label }</strong>
                                if step.Complete && step.Key != "review" {
                                    <span class="activation-progress-check" aria-label="Concluída">✓</span>
                                }
                            </button>
                        }
                    </nav>

                    if ActivationCanView(access, "policy") {
                        <section class="accept-box activation-wizard-panel" id="apolice" data-activation-step="policy" data-policy-present={ BoolString(access.Profile.HasPolicy) }>
                            <span class="step-title">APÓLICE</span>
                            <h2>Envie a apólice</h2>
                            <p>PDF, JPG ou PNG de até 15 MB.</p>
                            if ActivationCanEdit(access, "policy") {
                                <form method="post" action={ templ.SafeURL("/activation/" + token + "/policy?step=policy") } enctype="multipart/form-data" data-activation-step-form>
                                    if access.Profile.HasPolicy {
                                        <div class="activation-answer"><strong>Apólice recebida</strong><span>Se precisar substituir, escolha outro arquivo.</span></div>
                                    }
                                    <div class="field"><label>Arquivo da apólice</label><input name="document" type="file" accept="application/pdf,image/jpeg,image/png" required?={ !access.Profile.HasPolicy }/></div>
                                    <div class="activation-form-actions">
                                        <button class="btn ghost" type="button" data-activation-previous>Voltar</button>
                                        if access.Profile.HasPolicy {
                                            <button class="btn ghost" type="button" data-activation-next>Continuar</button>
                                        }
                                        <button class="btn dark" type="submit" data-processing="Enviando apólice...">{ ActivationPolicyButton(access.Profile.HasPolicy) } e continuar</button>
                                    </div>
                                </form>
                            } else {
                                <div class="activation-answer"><strong>{ ActivationPolicyStatus(access.Profile.HasPolicy) }</strong></div>
                                @ActivationReadonlyNavigation()
                            }
                        </section>
                    }

                    if ActivationCanView(access, "finance") {
                        <section class="accept-box activation-wizard-panel" id="financeiro" data-activation-step="finance">
                            <span class="step-title">FINANCEIRO</span>
                            <h2>Quem será o contato financeiro?</h2>
                            <p>Indique a pessoa responsável pelo faturamento.</p>
                            if ActivationCanEdit(access, "finance") {
                                <form method="post" action={ templ.SafeURL("/activation/" + token + "/finance?step=finance") } class="grid" data-activation-step-form>
                                    <div class="field"><label>Nome</label><input name="finance_name" value={ access.Profile.FinanceResponsibleName } required/></div>
                                    <div class="field"><label>Telefone</label><input name="finance_phone" value={ brfields.FormatPhone(access.Profile.FinanceResponsiblePhone) } inputmode="tel" required/></div>
                                    <div class="field full"><label>E-mail</label><input type="email" name="finance_email" value={ access.Profile.FinanceResponsibleEmail } required/></div>
                                    <div class="field full activation-form-actions">
                                        <button class="btn ghost" type="button" data-activation-previous>Voltar</button>
                                        <button class="btn dark" type="submit" data-processing="Salvando contato...">Salvar e continuar</button>
                                    </div>
                                </form>
                            } else {
                                <div class="activation-answer"><strong>{ access.Profile.FinanceResponsibleName }</strong><span>{ access.Profile.FinanceResponsibleEmail } · { brfields.FormatPhone(access.Profile.FinanceResponsiblePhone) }</span></div>
                                @ActivationReadonlyNavigation()
                            }
                        </section>
                    }

                    if ActivationCanView(access, "goods") {
                        <section class="accept-box activation-wizard-panel" id="mercadorias" data-activation-step="goods">
                            <span class="step-title">MERCADORIAS</span>
                            <h2>Quais mercadorias vocês transportam?</h2>
                            <p>Informe pelo menos um tipo de mercadoria.</p>
                            if ActivationCanEdit(access, "goods") {
                                <form method="post" action={ templ.SafeURL("/activation/" + token + "/goods?step=goods") } data-activation-step-form>
                                    <div data-activation-goods data-persisted-complete={ BoolString(len(access.Profile.Goods) > 0) }>
                                        if len(access.Profile.Goods) == 0 {
                                            <div class="activation-repeat-row"><input name="goods" placeholder="Ex.: Alimentos refrigerados" required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
                                        }
                                        for _, good := range access.Profile.Goods {
                                            <div class="activation-repeat-row"><input name="goods" value={ good } required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
                                        }
                                    </div>
                                    <div class="activation-form-actions">
                                        <button class="btn ghost" type="button" data-add-activation-good>+ Adicionar mercadoria</button>
                                        <button class="btn ghost" type="button" data-activation-previous>Voltar</button>
                                        <button class="btn dark" type="submit" data-activation-section-save="goods" data-processing="Salvando mercadorias..." disabled?={ len(access.Profile.Goods) == 0 }>Salvar e continuar</button>
                                    </div>
                                </form>
                            } else {
                                <div class="activation-tags">
                                    for _, good := range access.Profile.Goods {
                                        <span>{ good }</span>
                                    }
                                </div>
                                @ActivationReadonlyNavigation()
                            }
                        </section>
                    }

                    if ActivationCanView(access, "users") {
                        <section class="accept-box activation-wizard-panel" id="usuarios" data-activation-step="users">
                            <span class="step-title">USUÁRIOS</span>
                            <h2>Quem utilizará o sistema?</h2>
                            <p>Informe os primeiros usuários. Outros poderão ser cadastrados depois.</p>
                            if ActivationCanEdit(access, "users") {
                                <form method="post" action={ templ.SafeURL("/activation/" + token + "/users?step=users") } data-activation-step-form>
                                    <div data-activation-users data-persisted-complete={ BoolString(len(access.Profile.SystemUsers) > 0) }>
                                        if len(access.Profile.SystemUsers) == 0 {
                                            <div class="activation-user-row"><input name="system_user_name" placeholder="Nome" required/><input name="system_user_phone" placeholder="Telefone (opcional)"/><input type="email" name="system_user_email" placeholder="E-mail" required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
                                        }
                                        for _, systemUser := range access.Profile.SystemUsers {
                                            <div class="activation-user-row"><input name="system_user_name" value={ systemUser.Name } required/><input name="system_user_phone" value={ brfields.FormatPhone(systemUser.Phone) }/><input type="email" name="system_user_email" value={ systemUser.Email } required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
                                        }
                                    </div>
                                    <div class="activation-form-actions">
                                        <button class="btn ghost" type="button" data-add-activation-user>+ Adicionar usuário</button>
                                        <button class="btn ghost" type="button" data-activation-previous>Voltar</button>
                                        <button class="btn dark" type="submit" data-activation-section-save="users" data-processing="Salvando usuários..." disabled?={ len(access.Profile.SystemUsers) == 0 }>Salvar e continuar</button>
                                    </div>
                                </form>
                            } else {
                                <div class="activation-user-list">
                                    for _, systemUser := range access.Profile.SystemUsers {
                                        <div><strong>{ systemUser.Name }</strong><span>{ systemUser.Email } · { brfields.FormatPhone(systemUser.Phone) }</span></div>
                                    }
                                </div>
                                @ActivationReadonlyNavigation()
                            }
                        </section>
                    }

                    if access.Section == "all" {
                        <section class="accept-box activation-wizard-panel activation-review" data-activation-step="review" id="revisao">
                            <span class="step-title">REVISÃO FINAL</span>
                            <h2>Confira os dados da implantação</h2>
                            <p>Revise as informações salvas. Se precisar corrigir alguma etapa, selecione Editar.</p>

                            <div class="activation-review-card">
                                <div class="activation-review-head"><h3>Empresa</h3><span>Confirmada na contratação</span></div>
                                <dl class="activation-review-data">
                                    <dt>Razão social</dt><dd>{ access.Profile.LegalName } · { brfields.FormatCNPJ(access.Profile.CNPJ) }</dd>
                                    <dt>Endereço</dt><dd>{ ActivationAddress(access.Profile) }</dd>
                                    <dt>Responsável pela empresa</dt><dd>{ access.Profile.CompanyResponsibleName } · { access.Profile.CompanyResponsibleEmail } · { brfields.FormatPhone(access.Profile.CompanyResponsiblePhone) }</dd>
                                </dl>
                            </div>

                            if access.Profile.RequiresPolicy {
                                <div class="activation-review-card">
                                    <div class="activation-review-head"><h3>Apólice</h3><button class="btn ghost" type="button" data-activation-edit="policy">Editar</button></div>
                                    <p>{ ActivationPolicyStatus(access.Profile.HasPolicy) }</p>
                                </div>
                            }

                            <div class="activation-review-card">
                                <div class="activation-review-head"><h3>Contato financeiro</h3><button class="btn ghost" type="button" data-activation-edit="finance">Editar</button></div>
                                if ActivationFinanceComplete(access.Profile) {
                                    <dl class="activation-review-data">
                                        <dt>Nome</dt><dd>{ access.Profile.FinanceResponsibleName }</dd>
                                        <dt>Telefone</dt><dd>{ brfields.FormatPhone(access.Profile.FinanceResponsiblePhone) }</dd>
                                        <dt>E-mail</dt><dd>{ access.Profile.FinanceResponsibleEmail }</dd>
                                    </dl>
                                } else {
                                    <p class="activation-review-pending">Contato financeiro pendente.</p>
                                }
                            </div>

                            if access.Profile.RequiresPolicy {
                                <div class="activation-review-card">
                                    <div class="activation-review-head"><h3>Mercadorias</h3><button class="btn ghost" type="button" data-activation-edit="goods">Editar</button></div>
                                    if len(access.Profile.Goods) > 0 {
                                        <div class="activation-tags">
                                            for _, good := range access.Profile.Goods {
                                            <span>{ good }</span>
                                        }
                                        </div>
                                    } else {
                                        <p class="activation-review-pending">Nenhuma mercadoria informada.</p>
                                    }
                                </div>
                            }

                            <div class="activation-review-card">
                                <div class="activation-review-head"><h3>Usuários iniciais</h3><button class="btn ghost" type="button" data-activation-edit="users">Editar</button></div>
                                if len(access.Profile.SystemUsers) > 0 {
                                    <div class="activation-user-list">
                                        for _, user := range access.Profile.SystemUsers {
                                            <div><strong>{ user.Name }</strong><span>{ user.Email } · { brfields.FormatPhone(user.Phone) }</span></div>
                                        }
                                    </div>
                                } else {
                                    <p class="activation-review-pending">Nenhum usuário informado.</p>
                                }
                            </div>

                            if access.AccessType == "owner" {
                                <details class="activation-delegate-details">
                                    <summary>Encaminhar uma etapa para outra pessoa</summary>
                                    <p>Envie um link individual para alguém que possa ajudar no preenchimento.</p>
                                    <form method="post" action={ templ.SafeURL("/activation/" + token + "/delegate?step=review") } class="grid">
                                        <div class="field"><label>Nome</label><input name="delegate_name" required/></div>
                                        <div class="field"><label>E-mail</label><input type="email" name="delegate_email" required/></div>
                                        <div class="field full">
                                            <label>Etapas autorizadas</label>
                                            <select name="delegate_section">
                                                <option value="all">Toda a preparação</option>
                                                <option value="finance">Somente financeiro</option>
                                                if access.Profile.RequiresPolicy {
                                                    <option value="goods">Somente mercadorias</option>
                                                }
                                                <option value="users">Somente usuários</option>
                                            </select>
                                        </div>
                                        <div class="field full"><button class="btn ghost" type="submit" data-processing="Enviando convite...">Enviar convite</button></div>
                                    </form>
                                </details>
                            }

                            if !ActivationComplete(access.Profile) {
                                <p class="activation-review-pending" role="status">Existem etapas pendentes. Complete os dados antes de confirmar.</p>
                            } else if !ActivationContractSigned(access.Profile) {
                                <p class="activation-review-pending">Seus dados foram concluídos. A equipe ViaGate acompanhará as demais pendências da implantação.</p>
                            }

                            <div class="activation-form-actions">
                                <button class="btn ghost" type="button" data-activation-previous>Voltar</button>
                                <form method="post" action={ templ.SafeURL("/activation/" + token + "/submit?step=review") }>
                                    <button class="btn primary" type="submit" data-processing="Confirmando dados..." disabled?={ !ActivationComplete(access.Profile) }>Confirmar dados da implantação</button>
                                </form>
                            </div>
                        </section>
                    }

                    if access.Section != "all" {
                        <p class="activation-scoped-note">Seu acesso permite preencher apenas esta etapa. Depois de salvar, os dados ficam disponíveis para a equipe de implantação.</p>
                    }
                }
            </main>
            <script src="/commercial-assets/activation.js" defer></script>
        </div>
    }
}

templ ActivationReadonlyNavigation() {
    <div class="activation-form-actions">
        <button class="btn ghost" type="button" data-activation-previous>Voltar</button>
        <button class="btn dark" type="button" data-activation-next>Continuar</button>
    </div>
}

templ ActivationsAdminPage(user domain.User, items []activation.AdminItem) {
	@AdminLayout("Ativações", user) {
		@AdminPageHeader("IMPLANTAÇÃO", "Dados para ativação", "Acompanhe o que ainda depende do cliente e o que já está pronto para implantação.")
		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "ativação(ões)") {
				@AdminListSearch("Buscar cliente ou comercial...")
				@AdminListFilter("Status", "status") {
					<option value="">Todos os status</option>
					<option value="pending">Aguardando dados</option>
					<option value="in_progress">Em preenchimento</option>
					<option value="completed">Dados recebidos</option>
					<option value="under_internal_setup">Em implantação</option>
					<option value="activated">Operação liberada</option>
				}
			}
			@AdminDataTable([]string{"Cliente", "Comercial", "Status", "Dados", "Contrato", "Ações"}, len(items), "Nenhuma ativação encontrada.") {
				for _, item := range items {
					<tr data-admin-list-row data-search={ item.ClientName + " " + item.CommercialName + " " + ActivationAdminStatusLabel(item) } data-filter-status={ item.Status }>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Comercial">{ item.CommercialName }</td>
						<td data-label="Status"><span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ ActivationAdminStatusLabel(item) }</span></td>
						<td data-label="Dados">
							if item.RequiresPolicy {
								{ fmt.Sprintf("%d mercadorias · %d usuários", item.GoodsCount, item.SystemUserCount) }
							} else {
								{ fmt.Sprintf("%d usuários", item.SystemUserCount) }
							}
						</td>
						<td data-label="Contrato">{ DateTime(item.FullySignedAt) }</td>
						<td data-label="Ações" data-actions="true"><div class="admin-list-actions"><a class="btn" href={ templ.SafeURL("/admin/activations/" + item.ProfileID) }>Abrir</a></div></td>
					</tr>
				}
			}
		</div>
	}
}

templ ActivationAdminDetailPage(user domain.User, profile activation.Profile) {
	@AdminLayout("Ativação", user) {
		@AdminPageHeader("DADOS PARA ATIVAÇÃO", profile.LegalName, ActivationStatusLabel(profile.Status)) {
			<a class="btn ghost" href={ templ.SafeURL("/admin/contracts/" + profile.ContractID + "/document") }>Abrir contrato</a>
		}
		<div class="grid cols-2 activation-admin-grid">
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Empresa e contratação</h2></header>
				<div class="panel-body">
					<dl class="data-list">
						<dt>CNPJ</dt><dd>{ brfields.FormatCNPJ(profile.CNPJ) }</dd>
						<dt>Endereço</dt><dd>{ ActivationAddress(profile) }</dd>
						if profile.RequiresPolicy {
							<dt>Operação</dt><dd>{ humanOperationType(profile.OperationType) }</dd>
							<dt>Seguradora</dt><dd>{ profile.Insurer }</dd>
							<dt>Apólice</dt><dd>{ ActivationPolicyStatus(profile.HasPolicy) }</dd>
						}
						<dt>Contrato</dt><dd>{ ActivationContractStatus(profile) }</dd>
						<dt>Responsável</dt><dd>{ profile.CompanyResponsibleName } · { profile.CompanyResponsibleEmail }</dd>
					</dl>
				</div>
			</section>
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Financeiro</h2></header>
				<div class="panel-body">
					<dl class="data-list">
						<dt>Responsável</dt><dd>{ profile.FinanceResponsibleName }</dd>
						<dt>E-mail</dt><dd>{ profile.FinanceResponsibleEmail }</dd>
						<dt>Telefone</dt><dd>{ brfields.FormatPhone(profile.FinanceResponsiblePhone) }</dd>
					</dl>
				</div>
			</section>
			if profile.RequiresPolicy {
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Mercadorias</h2></header>
				<div class="panel-body">
					if len(profile.Goods) > 0 {
						<div class="activation-tags">
							for _, good := range profile.Goods {
								<span>{ good }</span>
							}
						</div>
					} else {
						<p class="activation-admin-empty">Nenhuma mercadoria informada.</p>
					}
				</div>
			</section>
			}
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Usuários iniciais</h2></header>
				<div class="panel-body">
					if len(profile.SystemUsers) > 0 {
						<div class="activation-user-list">
							for _, systemUser := range profile.SystemUsers {
								<div><strong>{ systemUser.Name }</strong><span>{ systemUser.Email } · { brfields.FormatPhone(systemUser.Phone) }</span></div>
							}
						</div>
					} else {
						<p class="activation-admin-empty">Nenhum usuário inicial informado.</p>
					}
				</div>
			</section>
		</div>
        if profile.Status == "completed" && ActivationContractSigned(profile) &&
            profile.RequiresPolicy && !ActivationOperationComplete(profile) {
            <section class="panel activation-admin-implementation admin-page-section-gap">
                <header class="panel-head"><h2>Aguardando operação comercial</h2></header>
                <div class="panel-body">
                    <p>Os dados do cliente foram recebidos. O comercial precisa concluir Operação e seguro no Pós-venda.</p>
                    if UserCan(user, "proposal.create") {
                        <a class="btn dark" href={ templ.SafeURL("/admin/post-sales/" + profile.ContractID) }>Abrir Pós-venda</a>
                    }
                </div>
            </section>
        }
        if (profile.Status == "completed" || profile.Status == "under_internal_setup") &&
            ActivationContractSigned(profile) && (!profile.RequiresPolicy || ActivationOperationComplete(profile)) {
			<section class="panel activation-admin-implementation admin-page-section-gap">
				<header class="panel-head">
					<div>
						<h2>Implantação interna</h2>
						<p>Os dados do cliente já foram concluídos. Atualize o estágio conforme a preparação interna avançar.</p>
					</div>
				</header>
				<div class="panel-body">
					<div class="actions">
						if profile.Status == "completed" {
							<form method="post" action={ templ.SafeURL("/admin/activations/" + profile.ID + "/status") }><input type="hidden" name="status" value="under_internal_setup"/><button class="btn dark" type="submit">Iniciar implantação</button></form>
						}
						if profile.Status == "under_internal_setup" {
							<form method="post" action={ templ.SafeURL("/admin/activations/" + profile.ID + "/status") }><input type="hidden" name="status" value="activated"/><button class="btn primary" type="submit">Marcar operação como liberada</button></form>
						}
					</div>
				</div>
			</section>
		}
	}
}
