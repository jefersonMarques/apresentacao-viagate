package templates

import (
	"fmt"

	"github.com/jefersonMarques/apresentacao-viagate/internal/activation"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
	"github.com/jefersonMarques/apresentacao-viagate/internal/platform/brfields"
)

templ ActivationPage(access activation.Access, token, message, errorMessage string) {
	@PublicFlowLayout("ViaGate — Dados para ativação") {
		<link rel="stylesheet" href="/commercial-assets/activation.css"/>
		<link rel="stylesheet" href="/commercial-assets/activation-public.css"/>
		<div class="public activation-public">
			<main class="proposal-page activation-page">
				<header class="activation-hero">
					<span class="step-title">DADOS PARA ATIVAÇÃO</span>
					<h1>Vamos preparar sua operação.</h1>
					<p>O contrato e a preparação da operação seguem em paralelo. Você pode concluir estes dados agora ou encaminhar o preenchimento para alguém da sua equipe.</p>
					<div class="activation-status-line"><strong>{ ActivationStatusLabel(access.Profile.Status) }</strong> · { access.Profile.LegalName }</div>
					@PublicProposalLink("/activation/" + token + "/proposal")
				</header>

				@PublicFlashMessages(message, errorMessage)

				<section class="activation-progress">
					<div class={ "activation-progress-item " + activationDoneClass(access.Profile.HasPolicy) }><span></span><strong>Apólice</strong></div>
					<div class={ "activation-progress-item " + activationDoneClass(access.Profile.FinanceResponsibleName != "") }><span></span><strong>Financeiro</strong></div>
					<div class={ "activation-progress-item " + activationDoneClass(len(access.Profile.Goods) > 0) }><span></span><strong>Mercadorias</strong></div>
					<div class={ "activation-progress-item " + activationDoneClass(len(access.Profile.SystemUsers) > 0) }><span></span><strong>Usuários</strong></div>
				</section>

				<section class="accept-box activation-readonly">
					<span class="step-title">DADOS JÁ CONFIRMADOS</span>
					<h2>Não é necessário preencher novamente</h2>
					<div class="activation-summary-grid">
						<div><small>Empresa</small><strong>{ access.Profile.LegalName }</strong><span>{ brfields.FormatCNPJ(access.Profile.CNPJ) }</span></div>
						<div><small>Endereço</small><strong>{ ActivationAddress(access.Profile) }</strong></div>
						<div><small>Operação</small><strong>{ humanOperationType(access.Profile.OperationType) }</strong><span>{ access.Profile.Insurer }</span></div>
						<div><small>Responsável pela empresa</small><strong>{ access.Profile.CompanyResponsibleName }</strong><span>{ access.Profile.CompanyResponsibleEmail } · { brfields.FormatPhone(access.Profile.CompanyResponsiblePhone) }</span></div>
					</div>
					<p class="activation-lock-note">Esses dados vieram da contratação e permanecem vinculados ao contrato gerado. Alterações operacionais nesta etapa não modificam o documento contratual.</p>
				</section>

				if !ActivationContractSigned(access.Profile) {
					<section class="notice">
						<strong>Contrato aguardando assinatura.</strong>
						<span>Você pode concluir toda a preparação agora. A implantação interna só será liberada depois que o contrato for assinado.</span>
					</section>
				}

				<section class="accept-box" id="apolice">
					<span class="step-title">1 · APÓLICE</span>
					<h2>Envie a apólice da operação</h2>
					<p>O arquivo não faz parte do contrato. Ele será usado pela equipe de implantação e pode ser enviado enquanto o contrato aguarda assinatura.</p>
					if ActivationCanEdit(access, "policy") {
						<form method="post" action={ templ.SafeURL("/activation/" + token + "/policy") } enctype="multipart/form-data">
							<div class="field">
								<label>Apólice</label>
								<input name="document" type="file" accept="application/pdf,image/jpeg,image/png" required/>
							</div>
							<p class="activation-step-requirement">PDF, JPG ou PNG · máximo 15 MB.</p>
							<div class="actions activation-step-actions">
								<span>{ ActivationPolicyStatus(access.Profile.HasPolicy) }</span>
								<button class="btn dark" type="submit" data-processing="Enviando apólice...">{ ActivationPolicyButton(access.Profile.HasPolicy) }</button>
							</div>
						</form>
					} else {
						<div class="activation-answer"><strong>{ ActivationPolicyStatus(access.Profile.HasPolicy) }</strong></div>
					}
				</section>

				<section class="accept-box" id="financeiro">
					<span class="step-title">2 · FINANCEIRO</span>
					<h2>Quem será o contato financeiro?</h2>
					<p>Essa pessoa receberá os contatos relacionados a faturamento e assuntos financeiros da operação.</p>
					if ActivationCanEdit(access, "finance") {
						<form method="post" action={ templ.SafeURL("/activation/" + token + "/finance") } class="grid">
							<div class="field"><label>Nome</label><input name="finance_name" value={ access.Profile.FinanceResponsibleName } required/></div>
							<div class="field"><label>Telefone</label><input name="finance_phone" value={ brfields.FormatPhone(access.Profile.FinanceResponsiblePhone) } inputmode="tel" required/></div>
							<div class="field full"><label>E-mail</label><input type="email" name="finance_email" value={ access.Profile.FinanceResponsibleEmail } required/></div>
							<div class="field full"><button class="btn dark" type="submit" data-processing="Salvando...">Salvar contato financeiro</button></div>
						</form>
					} else {
						<div class="activation-answer"><strong>{ access.Profile.FinanceResponsibleName }</strong><span>{ access.Profile.FinanceResponsibleEmail } · { brfields.FormatPhone(access.Profile.FinanceResponsiblePhone) }</span></div>
					}
				</section>

				<section class="accept-box" id="mercadorias">
					<span class="step-title">3 · OPERAÇÃO</span>
					<h2>Quais mercadorias vocês transportam?</h2>
					<p>Liste os principais tipos. Você pode adicionar quantos forem necessários.</p>
					if ActivationCanEdit(access, "goods") {
						<form method="post" action={ templ.SafeURL("/activation/" + token + "/goods") }>
							<div data-activation-goods data-persisted-complete={ BoolString(len(access.Profile.Goods) > 0) }>
								if len(access.Profile.Goods) == 0 {
									<div class="activation-repeat-row"><input name="goods" placeholder="Ex.: Queijos frescos" required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
								}
								for _, good := range access.Profile.Goods {
									<div class="activation-repeat-row"><input name="goods" value={ good } required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
								}
							</div>
							<p class="activation-step-requirement">Obrigatório: informe pelo menos uma mercadoria.</p>
							<div class="actions activation-step-actions"><button type="button" class="btn ghost" data-add-activation-good>+ Adicionar mercadoria</button><button class="btn dark" type="submit" data-activation-section-save="goods" data-processing="Salvando..." disabled?={ len(access.Profile.Goods) == 0 }>Salvar e continuar</button></div>
						</form>
					} else {
						<div class="activation-tags">
							for _, good := range access.Profile.Goods {
								<span>{ good }</span>
							}
						</div>
					}
				</section>

				<section class="accept-box" id="usuarios">
					<span class="step-title">4 · ACESSOS</span>
					<h2>Quem utilizará o sistema?</h2>
					<p>Informe apenas quem precisa receber acesso inicialmente. Outros usuários poderão ser cadastrados depois.</p>
					if ActivationCanEdit(access, "users") {
						<form method="post" action={ templ.SafeURL("/activation/" + token + "/users") }>
							<div data-activation-users data-persisted-complete={ BoolString(len(access.Profile.SystemUsers) > 0) }>
								if len(access.Profile.SystemUsers) == 0 {
									<div class="activation-user-row"><input name="system_user_name" placeholder="Nome" required/><input name="system_user_phone" placeholder="Telefone"/><input type="email" name="system_user_email" placeholder="E-mail" required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
								}
								for _, systemUser := range access.Profile.SystemUsers {
									<div class="activation-user-row"><input name="system_user_name" value={ systemUser.Name } required/><input name="system_user_phone" value={ brfields.FormatPhone(systemUser.Phone) }/><input type="email" name="system_user_email" value={ systemUser.Email } required/><button type="button" class="btn ghost activation-remove" aria-label="Remover">×</button></div>
								}
							</div>
							<p class="activation-step-requirement">Obrigatório: informe pelo menos um usuário com nome e e-mail válidos.</p>
							<div class="actions activation-step-actions"><button type="button" class="btn ghost" data-add-activation-user>+ Adicionar usuário</button><button class="btn dark" type="submit" data-activation-section-save="users" data-processing="Salvando..." disabled?={ len(access.Profile.SystemUsers) == 0 }>Salvar e revisar</button></div>
						</form>
					} else {
						<div class="activation-user-list">
							for _, systemUser := range access.Profile.SystemUsers {
								<div><strong>{ systemUser.Name }</strong><span>{ systemUser.Email } · { brfields.FormatPhone(systemUser.Phone) }</span></div>
							}
						</div>
					}
				</section>

				if access.AccessType == "owner" && access.Section == "all" && access.Profile.Status != "under_internal_setup" && access.Profile.Status != "activated" {
					<section class="accept-box activation-delegate">
						<span class="step-title">ENCAMINHAR PREENCHIMENTO</span>
						<h2>Outra pessoa pode finalizar estes dados</h2>
						<p>Envie um link individual para um funcionário ou responsável da sua equipe. O contrato continuará com o responsável legal, sem impedir o preenchimento operacional.</p>
						<form method="post" action={ templ.SafeURL("/activation/" + token + "/delegate") } class="grid">
							<div class="field"><label>Nome</label><input name="delegate_name" required/></div>
							<div class="field"><label>E-mail</label><input type="email" name="delegate_email" required/></div>
							<div class="field full">
								<label>O que poderá preencher</label>
								<select name="delegate_section">
									<option value="all">Toda a preparação</option>
									<option value="finance">Somente financeiro</option>
									<option value="goods">Somente mercadorias</option>
									<option value="users">Somente usuários</option>
								</select>
							</div>
							<div class="field full"><button class="btn ghost" type="submit" data-processing="Enviando convite...">Enviar convite</button></div>
						</form>
					</section>
				}

				if access.Profile.Status == "completed" || access.Profile.Status == "under_internal_setup" || access.Profile.Status == "activated" {
					<section class="accept-box activation-complete-box">
						<span class="step-title">DADOS RECEBIDOS</span>
						if ActivationContractSigned(access.Profile) {
							<h2>A ViaGate já pode prosseguir.</h2>
							<p>As informações necessárias foram recebidas e o contrato está assinado. A implantação interna pode avançar.</p>
						} else {
							<h2>Preparação concluída.</h2>
							<p>Os dados foram recebidos. Agora falta apenas a assinatura do contrato para liberar a implantação interna.</p>
						}
					</section>
				} else if ActivationComplete(access.Profile) {
					<section class="accept-box activation-submit-box">
						<span class="step-title">ÚLTIMO PASSO</span>
						<h2>Todos os dados necessários estão preenchidos.</h2>
						<p>Revise as informações acima e conclua a preparação. Se o contrato ainda estiver pendente, a implantação ficará aguardando apenas a assinatura.</p>
						<form method="post" action={ templ.SafeURL("/activation/" + token + "/submit") }><button class="btn primary" type="submit" data-processing="Enviando dados...">Concluir preparação</button></form>
					</section>
				}
			</main>
			<script src="/commercial-assets/activation.js" defer></script>
		</div>
	}
}

templ ActivationsAdminPage(user domain.User, items []activation.AdminItem) {
	@AdminLayout("Ativações", user) {
		@AdminPageHeader("IMPLANTAÇÃO", "Dados para ativação", "Acompanhe o que ainda depende do cliente e o que já está pronto para implantação.")
		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "ativação(ões)") {
				@AdminListSearch("Buscar cliente ou comercial...")
				@AdminListFilter("Status", "status") {
					<option value="">Todos os status</option>
					<option value="pending">Aguardando dados</option>
					<option value="in_progress">Em preenchimento</option>
					<option value="completed">Dados recebidos</option>
					<option value="under_internal_setup">Em implantação</option>
					<option value="activated">Operação liberada</option>
				}
			}
			@AdminDataTable([]string{"Cliente", "Comercial", "Status", "Dados", "Contrato", "Ações"}, len(items), "Nenhuma ativação encontrada.") {
				for _, item := range items {
					<tr data-admin-list-row data-search={ item.ClientName + " " + item.CommercialName + " " + ActivationStatusLabel(item.Status) } data-filter-status={ item.Status }>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Comercial">{ item.CommercialName }</td>
						<td data-label="Status"><span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ ActivationStatusLabel(item.Status) }</span></td>
						<td data-label="Dados">{ fmt.Sprintf("%d mercadorias · %d usuários", item.GoodsCount, item.SystemUserCount) }</td>
						<td data-label="Contrato">{ DateTime(item.FullySignedAt) }</td>
						<td data-label="Ações" data-actions="true"><div class="admin-list-actions"><a class="btn" href={ templ.SafeURL("/admin/activations/" + item.ProfileID) }>Abrir</a></div></td>
					</tr>
				}
			}
		</div>
	}
}

templ ActivationAdminDetailPage(user domain.User, profile activation.Profile) {
	@AdminLayout("Ativação", user) {
		@AdminPageHeader("DADOS PARA ATIVAÇÃO", profile.LegalName, ActivationStatusLabel(profile.Status)) {
			<a class="btn ghost" href={ templ.SafeURL("/admin/contracts/" + profile.ContractID + "/document") }>Abrir contrato</a>
		}
		<div class="grid cols-2 activation-admin-grid">
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Empresa e contratação</h2></header>
				<div class="panel-body">
					<dl class="data-list">
						<dt>CNPJ</dt><dd>{ brfields.FormatCNPJ(profile.CNPJ) }</dd>
						<dt>Endereço</dt><dd>{ ActivationAddress(profile) }</dd>
						<dt>Operação</dt><dd>{ humanOperationType(profile.OperationType) }</dd>
						<dt>Seguradora</dt><dd>{ profile.Insurer }</dd>
						<dt>Apólice</dt><dd>{ ActivationPolicyStatus(profile.HasPolicy) }</dd>
						<dt>Contrato</dt><dd>{ ActivationContractStatus(profile) }</dd>
						<dt>Responsável</dt><dd>{ profile.CompanyResponsibleName } · { profile.CompanyResponsibleEmail }</dd>
					</dl>
				</div>
			</section>
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Financeiro</h2></header>
				<div class="panel-body">
					<dl class="data-list">
						<dt>Responsável</dt><dd>{ profile.FinanceResponsibleName }</dd>
						<dt>E-mail</dt><dd>{ profile.FinanceResponsibleEmail }</dd>
						<dt>Telefone</dt><dd>{ brfields.FormatPhone(profile.FinanceResponsiblePhone) }</dd>
					</dl>
				</div>
			</section>
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Mercadorias</h2></header>
				<div class="panel-body">
					if len(profile.Goods) > 0 {
						<div class="activation-tags">
							for _, good := range profile.Goods {
								<span>{ good }</span>
							}
						</div>
					} else {
						<p class="activation-admin-empty">Nenhuma mercadoria informada.</p>
					}
				</div>
			</section>
			<section class="panel activation-admin-panel">
				<header class="panel-head"><h2>Usuários iniciais</h2></header>
				<div class="panel-body">
					if len(profile.SystemUsers) > 0 {
						<div class="activation-user-list">
							for _, systemUser := range profile.SystemUsers {
								<div><strong>{ systemUser.Name }</strong><span>{ systemUser.Email } · { brfields.FormatPhone(systemUser.Phone) }</span></div>
							}
						</div>
					} else {
						<p class="activation-admin-empty">Nenhum usuário inicial informado.</p>
					}
				</div>
			</section>
		</div>
		if (profile.Status == "completed" || profile.Status == "under_internal_setup") && ActivationContractSigned(profile) {
			<section class="panel activation-admin-implementation admin-page-section-gap">
				<header class="panel-head">
					<div>
						<h2>Implantação interna</h2>
						<p>Os dados do cliente já foram concluídos. Atualize o estágio conforme a preparação interna avançar.</p>
					</div>
				</header>
				<div class="panel-body">
					<div class="actions">
						if profile.Status == "completed" {
							<form method="post" action={ templ.SafeURL("/admin/activations/" + profile.ID + "/status") }><input type="hidden" name="status" value="under_internal_setup"/><button class="btn dark" type="submit">Iniciar implantação</button></form>
						}
						if profile.Status == "under_internal_setup" {
							<form method="post" action={ templ.SafeURL("/admin/activations/" + profile.ID + "/status") }><input type="hidden" name="status" value="activated"/><button class="btn primary" type="submit">Marcar operação como liberada</button></form>
						}
					</div>
				</div>
			</section>
		}
	}
}
