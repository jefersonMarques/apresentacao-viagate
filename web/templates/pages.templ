package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/domain"

templ Login(errorMessage string) {
	@Base("ViaGate — Acesso comercial") {
		<section class="auth">
			<div class="auth-brand">
				<div class="brand">VIAGATE</div>
				<div>
					<span class="step-title">PLATAFORMA COMERCIAL</span>
					<h1>Propostas, contratação e assinatura em um único fluxo.</h1>
				</div>
				<small>ViaGate · Ambiente restrito</small>
			</div>
			<div class="auth-form">
				<form class="auth-card" method="post" action="/login">
					<span class="step-title">ACESSO RESTRITO</span>
					<h1>Entrar</h1>
					if errorMessage != "" {
						<div class="notice error">{ errorMessage }</div>
					}
					<div class="field">
						<label for="email">E-mail</label>
						<input id="email" name="email" type="email" autocomplete="email" required/>
					</div>
					<div class="field" style="margin-top:12px">
						<label for="password">Senha</label>
						<input id="password" name="password" type="password" autocomplete="current-password" required/>
					</div>
					<div class="actions" style="margin-top:18px">
						<button class="btn primary" type="submit">Entrar</button>
					</div>
				</form>
			</div>
		</section>
	}
}

templ Dashboard(user domain.User) {
	@AdminLayout("ViaGate — Comercial", user) {
		<header class="header">
			<div>
				<span class="step-title">HUB COMERCIAL</span>
				<h1>Pipeline de contratação</h1>
				<p>O sistema acompanha a negociação desde a proposta até o onboarding e a assinatura do contrato.</p>
			</div>
		</header>
		<section class="grid">
			<a class="panel" href="/admin/pipeline" style="text-decoration:none">
				<div class="panel-body"><span class="step-title">PIPELINE</span><h2>Contratações</h2><p>Acompanhe propostas aceitas, cadastros, contratos e assinaturas.</p></div>
			</a>
			<a class="panel" href="/admin/proposals" style="text-decoration:none">
				<div class="panel-body"><span class="step-title">COMERCIAL</span><h2>Propostas</h2><p>Criação, publicação, versões imutáveis e acompanhamento de aceite.</p></div>
			</a>
			<a class="panel" href="/admin/presentations" style="text-decoration:none">
				<div class="panel-body"><span class="step-title">INSTITUCIONAL</span><h2>Apresentações</h2><p>Materiais personalizados por comercial e cliente.</p></div>
			</a>
			if HasRole(user, "super_admin") || HasRole(user, "operations") {
				<a class="panel" href="/admin/onboardings" style="text-decoration:none">
					<div class="panel-body"><span class="step-title">OPERAÇÕES</span><h2>Cadastros</h2><p>Revisão de dados, documentos e preparação do contrato.</p></div>
				</a>
			}
			if HasRole(user, "super_admin") || HasRole(user, "legal") {
				<a class="panel" href="/admin/contracts/templates" style="text-decoration:none">
					<div class="panel-body"><span class="step-title">JURÍDICO</span><h2>Modelos de contrato</h2><p>Markdown versionado com variáveis controladas.</p></div>
				</a>
			}
			if HasRole(user, "super_admin") {
				<a class="panel" href="/admin/users" style="text-decoration:none">
					<div class="panel-body"><span class="step-title">ADMINISTRAÇÃO</span><h2>Usuários</h2><p>Convites, funções e permissões.</p></div>
				</a>
			}
		</section>
	}
}

templ InvitationPage(name, email, token, errorMessage string) {
	@Base("ViaGate — Ativar acesso") {
		<section class="auth">
			<div class="auth-brand">
				<div class="brand">VIAGATE</div>
				<div><span class="step-title">CONVITE</span><h1>Ative seu acesso comercial.</h1></div>
				<small>O convite é individual e de uso único.</small>
			</div>
			<div class="auth-form">
				<form class="auth-card" method="post" action={ templ.SafeURL("/invite/" + token) }>
					<span class="step-title">CRIAR SENHA</span>
					<h1>{ name }</h1>
					<p>{ email }</p>
					if errorMessage != "" {
						<div class="notice error">{ errorMessage }</div>
					}
					<div class="field"><label>Senha</label><input name="password" type="password" minlength="10" autocomplete="new-password" required/></div>
					<div class="field" style="margin-top:12px"><label>Confirmar senha</label><input name="confirm_password" type="password" minlength="10" autocomplete="new-password" required/></div>
					<div class="actions" style="margin-top:18px"><button class="btn primary" type="submit">Ativar acesso</button></div>
				</form>
			</div>
		</section>
	}
}

templ ContractTemplatesPage(user domain.User, items []domain.ContractTemplate, variables []string, message, selectedID, selectedName, selectedDescription, selectedMarkdown string) {
	@AdminLayout("ViaGate — Modelos de contrato", user) {
		<link rel="stylesheet" href="/assets/v1-admin-forms.css"/>
		<div class="v1-page">
			<header class="v1-editor-header">
				<div>
					<span class="v1-eyebrow">CONTRATOS</span>
					<h1>Modelos versionados</h1>
					<p>Edite o conteúdo em Markdown com variáveis controladas. Cada salvamento cria uma nova versão e nunca altera contratos já gerados.</p>
				</div>
				<div class="v1-actions"><a class="v1-button primary" href="/admin/contracts/templates">Novo modelo</a></div>
			</header>
			if message != "" {
				<div class="v1-message">{ message }</div>
			}
			<div class="v1-contract-layout">
				<aside class="v1-contract-list">
					<div class="v1-contract-list-head"><h2>Modelos disponíveis</h2><div class="v1-help" style="margin-top:5px">Selecione um modelo para criar a próxima versão.</div></div>
					for _, item := range items {
						<a class="v1-contract-item" href={ templ.SafeURL("/admin/contracts/templates?template=" + item.ID) }>
							<strong>{ item.Name }</strong>
							<span>v{ item.CurrentVersion }</span>
							if item.IsActive {
								<span>Ativo</span>
							} else {
								<span>Inativo</span>
							}
							if item.Description != "" {
								<span>{ item.Description }</span>
							}
							if selectedID == item.ID {
								<span style="color:#ff6b18;font-weight:800">EDITANDO ESTE MODELO</span>
							}
						</a>
					}
					if len(items) == 0 {
						<div class="v1-contract-item"><strong>Nenhum modelo cadastrado</strong><span>Crie o primeiro modelo no editor.</span></div>
					}
				</aside>
				<section class="v1-contract-editor">
					<div class="v1-contract-editor-head">
						if selectedID == "" {
							<h2>Novo modelo</h2>
							<div class="v1-help" style="margin-top:5px">Crie a versão inicial de um novo contrato.</div>
						} else {
							<h2>Nova versão de { selectedName }</h2>
							<div class="v1-help" style="margin-top:5px">O conteúdo abaixo é uma cópia da versão atual. Ao salvar, uma nova versão imutável será criada.</div>
						}
					</div>
					<div class="v1-contract-editor-body">
						<form method="post" action="/admin/contracts/templates">
							<input type="hidden" name="template_id" value={ selectedID }/>
							<div class="v1-form-grid">
								<div class="v1-field"><label>Nome do modelo</label><input name="name" value={ selectedName } placeholder="Contrato padrão ViaGate" required/></div>
								<div class="v1-field"><label>Descrição</label><input name="description" value={ selectedDescription } placeholder="Quando este modelo deve ser usado"/></div>
								<div class="v1-field full">
									<label>Conteúdo Markdown</label>
									<textarea class="v1-contract-markdown" name="markdown" data-contract-markdown required placeholder="# CONTRATO\n\nCONTRATANTE: {client.legal_name} ...">{ selectedMarkdown }</textarea>
								</div>
							</div>
							<div style="margin-top:18px">
								<div class="v1-label" style="margin-bottom:8px">Inserir variável</div>
								<div class="v1-variable-cloud">
									for _, variable := range variables {
										<button class="v1-variable-chip" type="button" data-contract-variable={ "{" + variable + "}" }>{ "{" + variable + "}" }</button>
									}
								</div>
								<div class="v1-help" style="margin-top:8px">Clique em uma variável para inseri-la na posição atual do cursor.</div>
							</div>
							<label class="v1-option-card" style="margin-top:18px">
								<span class="v1-switch"><input type="checkbox" name="make_default" value="1"/><span class="v1-switch-track"></span></span>
								<span><strong>Usar como modelo padrão</strong><small>Novos contratos utilizarão este modelo quando não houver outra regra específica.</small></span>
							</label>
							<div class="v1-actions" style="margin-top:18px"><button class="v1-button primary" type="submit" data-processing="Salvando nova versão...">Salvar nova versão</button></div>
						</form>
					</div>
				</section>
			</div>
		</div>
	}
}
