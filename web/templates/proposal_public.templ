package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/proposals"

templ PublicProposalViewerPage(proposal proposals.PublicProposal, errorMessage string) {
	<!doctype html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#071827"/>
			<meta name="robots" content="noindex,nofollow,noarchive"/>
			<title>ViaGate — Proposta para { ProposalClientDisplayName(proposal) }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/v1/proposal.css"/>
			<link rel="stylesheet" href="/v1/proposal-view.css"/>
			<link rel="stylesheet" href="/v1/viewer-active.css"/>
			<link rel="stylesheet" href="/v1/proposal-premium.css"/>
			<link rel="stylesheet" href="/v1/proposal-social.css"/>
			<link rel="stylesheet" href="/v1/proposal-experience.css"/>
			<link rel="stylesheet" href="/commercial-assets/v1-proposal-go.css"/>
		</head>
		<body class="public-proposal proposal-locked viewer-locked">
			if errorMessage != "" {
				<div class="proposal-public-error proposal-public-error-global">{ errorMessage }</div>
			}
			<main id="proposalPresentation" data-secure-viewer>
				<section class="proposal-slide dark" data-viewer-slide>
					<div class="proposal-slide-inner proposal-cover-grid">
						<div>
							<img class="proposal-cover-logo" src="/v1/assets/logo-viagate-white.svg" alt="ViaGate"/>
							<p class="proposal-kicker">PROPOSTA COMERCIAL · VERSÃO { proposal.VersionNumber }</p>
							<h1>Preparada para<br/><span>{ ProposalClientDisplayName(proposal) }</span></h1>
							if ProposalSectionString(proposal,"contact","name") != "" {
								<p class="proposal-lead">
									Aos cuidados de { ProposalSectionString(proposal,"contact","name") }
									if ProposalSectionString(proposal,"contact","role") != "" {
										<span> · { ProposalSectionString(proposal,"contact","role") }</span>
									}
								</p>
							}
							if ProposalSectionString(proposal,"client","logo_url") != "" {
								<img class="proposal-client-logo" src={ templ.SafeURL(ProposalSectionString(proposal,"client","logo_url")) } alt={ ProposalClientDisplayName(proposal) }/>
							}
						</div>
						<aside class="proposal-person-card">
							if ProposalSalesperson(proposal,"photo_url") != "" {
								<img src={ templ.SafeURL(ProposalSalesperson(proposal,"photo_url")) } alt={ ProposalSalesperson(proposal,"name") }/>
							}
							<small>APRESENTADO POR</small>
							if ProposalSalesperson(proposal,"name") != "" {
								<strong>{ ProposalSalesperson(proposal,"name") }</strong>
							}
							if ProposalSalespersonRole(proposal) != "" {
								<span>{ ProposalSalespersonRole(proposal) }</span>
							}
							if ProposalSalesperson(proposal,"email") != "" {
								<span>{ ProposalSalesperson(proposal,"email") }</span>
							}
							if ProposalSalesperson(proposal,"phone") != "" {
								<span>{ Phone(ProposalSalesperson(proposal,"phone")) }</span>
							}
							if ProposalSalesperson(proposal,"linkedin") != "" || ProposalSalesperson(proposal,"instagram") != "" {
								<div class="proposal-social-links">
									if ProposalSalesperson(proposal,"linkedin") != "" {
										<a href={ templ.SafeURL(ProposalSalesperson(proposal,"linkedin")) } target="_blank" rel="noopener">LinkedIn</a>
									}
									if ProposalSalesperson(proposal,"instagram") != "" {
										<a href={ templ.SafeURL(ProposalSalesperson(proposal,"instagram")) } target="_blank" rel="noopener">Instagram</a>
									}
								</div>
							}
						</aside>
					</div>
					<div class="proposal-slide-footer"><span>Proposta comercial</span><span data-slide-number></span></div>
				</section>

				{{ priorities := ProposalContentStrings(proposal,"customer_priorities") }}
				if ProposalContentString(proposal,"operation_context") != "" || len(priorities) > 0 {
					<section class="proposal-slide light" data-viewer-slide>
						<div class="proposal-slide-inner">
							<div>
								<p class="proposal-kicker">CENÁRIO CONSIDERADO</p>
								<h2>Contexto da <span>operação</span></h2>
								if ProposalContentString(proposal,"operation_context") != "" {
									<p class="proposal-lead">{ ProposalContentString(proposal,"operation_context") }</p>
								}
								if len(priorities) > 0 {
									<div class="proposal-content-grid">
										for index, priority := range priorities {
											<article class="proposal-content-card"><small>{ index + 1 }</small><h3>{ priority }</h3></article>
										}
									</div>
								}
							</div>
						</div>
						<div class="proposal-slide-footer"><span>Cenário considerado</span><span data-slide-number></span></div>
					</section>
				}

				{{ solutionScope := ProposalContentStrings(proposal,"solution_scope") }}
				if ProposalContentString(proposal,"solution_title") != "" || len(solutionScope) > 0 {
					<section class="proposal-slide dark" data-viewer-slide>
						<div class="proposal-slide-inner">
							<div>
								<p class="proposal-kicker">SOLUÇÃO PROPOSTA</p>
								if ProposalContentString(proposal,"solution_title") != "" {
									<h2>{ ProposalContentString(proposal,"solution_title") }</h2>
								} else {
									<h2>Solução desenhada para <span>esta operação</span></h2>
								}
								if len(solutionScope) > 0 {
									<div class="proposal-content-grid">
										for index, scope := range solutionScope {
											<article class="proposal-content-card"><small>{ index + 1 }</small><h3>{ scope }</h3></article>
										}
									</div>
								}
							</div>
						</div>
						<div class="proposal-slide-footer"><span>Solução proposta</span><span data-slide-number></span></div>
					</section>
				}

				{{ modelCards := ProposalModelCards(proposal.PricingModel) }}
				if len(modelCards) > 0 {
					<section class="proposal-slide light" data-viewer-slide>
						<div class="proposal-slide-inner">
							<div>
								<p class="proposal-kicker">MODELO DE ANÁLISE CADASTRAL</p>
								if proposal.PricingModel == "item_and_bundle" {
									<h2>Duas formas de <span>compor a análise</span></h2>
								} else {
									<h2>{ ProposalModelLabel(proposal.PricingModel) }</h2>
								}
								<div class="proposal-model-grid">
									for index, model := range modelCards {
										<article class="proposal-model-card"><small>MODELO { index + 1 }</small><strong>{ model.Title }</strong><span>{ model.Summary }</span></article>
									}
								</div>
							</div>
						</div>
						<div class="proposal-slide-footer"><span>Modelo comercial</span><span data-slide-number></span></div>
					</section>
				}

				if len(proposal.Items) > 0 || proposal.MinimumInvoice > 0 || proposal.SetupFee > 0 {
					<section class="proposal-slide dark" data-viewer-slide>
						<div class="proposal-slide-inner">
							<div>
								<p class="proposal-kicker">INVESTIMENTO</p>
								<h2>Valores da <span>proposta comercial</span></h2>
								<p class="proposal-commercial-note">Os valores são aplicados de acordo com o uso e respeitam as condições definidas nesta versão.</p>
								if len(proposal.Items) > 0 {
									<div class="proposal-price-groups">
										for _, group := range ProposalPriceGroups(proposal) {
											<section class="proposal-price-group">
												<header class="proposal-price-group-header">
													<strong>{ group.Name }</strong>
													if group.AllOptional {
														<span class="proposal-optional-label">Opcional</span>
													}
												</header>
												<table class="proposal-price-table">
													<thead><tr><th>Item</th><th>Unidade</th><th>Status</th><th>Valor</th></tr></thead>
													<tbody>
														for _, item := range group.Items {
															<tr><td>{ item.Label }</td><td>{ item.Unit }</td><td>{ ProposalItemStatus(item) }</td><td>{ Money(item.Price) }</td></tr>
														}
													</tbody>
												</table>
											</section>
										}
									</div>
								}
								if proposal.MinimumInvoice > 0 || proposal.SetupFee > 0 {
									<div class="proposal-highlight-grid">
										if proposal.MinimumInvoice > 0 {
											<div class="proposal-highlight"><small>Fatura mínima mensal</small><strong>{ Money(proposal.MinimumInvoice) }</strong></div>
										}
										if proposal.SetupFee > 0 {
											<div class="proposal-highlight"><small>Implantação</small><strong>{ Money(proposal.SetupFee) }</strong></div>
										}
									</div>
								}
								<div class="proposal-accept-inline-wrap">
									<span>Pronto para avançar?</span>
									<button class="proposal-accept-inline" type="button" data-proposal-accept-inline>ACEITAR PROPOSTA</button>
								</div>
							</div>
						</div>
						<div class="proposal-slide-footer"><span>Investimento</span><span data-slide-number></span></div>
					</section>
				}

				if len(proposal.Conditions) > 0 || proposal.ValidUntil != nil {
					<section class="proposal-slide light" data-viewer-slide>
						<div class="proposal-slide-inner">
							<div>
								<p class="proposal-kicker">OBSERVAÇÕES E CONDIÇÕES</p>
								<h2>Condições <span>comerciais</span></h2>
								if len(proposal.Conditions) > 0 {
									<div class="proposal-content-grid">
										for index, condition := range proposal.Conditions {
											<article class="proposal-content-card"><small>{ index + 1 }</small><h3>{ condition }</h3></article>
										}
									</div>
								}
								if proposal.ValidUntil != nil {
									<div class="proposal-validity"><strong>Válida até { Date(proposal.ValidUntil) }</strong></div>
								}
							</div>
						</div>
						<div class="proposal-slide-footer"><span>Condições comerciais</span><span data-slide-number></span></div>
					</section>
				}

				<section class="proposal-slide orange" data-viewer-slide>
					<div class="proposal-slide-inner proposal-contact-final">
						<div>
							<p class="proposal-kicker" style="color:#fff">CONTATO COMERCIAL</p>
							if ProposalSalesperson(proposal,"name") != "" {
								<h2>{ ProposalSalesperson(proposal,"name") }</h2>
							} else {
								<h2>ViaGate</h2>
							}
							if ProposalSalespersonRole(proposal) != "" {
								<p class="proposal-lead" style="color:rgba(255,255,255,.84)">{ ProposalSalespersonRole(proposal) }</p>
							}
						</div>
						<aside class="proposal-contact-data">
							if ProposalSalesperson(proposal,"photo_url") != "" {
								<img src={ templ.SafeURL(ProposalSalesperson(proposal,"photo_url")) } alt={ ProposalSalesperson(proposal,"name") }/>
							}
							<small>CONTATO RESPONSÁVEL</small>
							if ProposalSalesperson(proposal,"name") != "" {
								<strong>{ ProposalSalesperson(proposal,"name") }</strong>
							}
							if ProposalSalesperson(proposal,"phone") != "" {
								<span>{ Phone(ProposalSalesperson(proposal,"phone")) }</span>
							}
							if ProposalSalesperson(proposal,"email") != "" {
								<span>{ ProposalSalesperson(proposal,"email") }</span>
							}
							if ProposalSalesperson(proposal,"linkedin") != "" || ProposalSalesperson(proposal,"instagram") != "" {
								<div class="proposal-social-links">
									if ProposalSalesperson(proposal,"linkedin") != "" {
										<a href={ templ.SafeURL(ProposalSalesperson(proposal,"linkedin")) } target="_blank" rel="noopener">LinkedIn</a>
									}
									if ProposalSalesperson(proposal,"instagram") != "" {
										<a href={ templ.SafeURL(ProposalSalesperson(proposal,"instagram")) } target="_blank" rel="noopener">Instagram</a>
									}
								</div>
							}
						</aside>
					</div>
					<div class="proposal-slide-footer"><span>Contato comercial</span><span data-slide-number></span></div>
				</section>
			</main>

			<div class="proposal-view-gate" data-viewer-gate role="dialog" aria-modal="true" aria-label="Controle da proposta">
				<div class="proposal-view-action">
					<div class="proposal-view-action-row">
						<button class="proposal-view-button secondary" data-viewer-restart type="button" hidden>VOLTAR AO INÍCIO</button>
						<button class="proposal-view-button" data-viewer-start data-viewer-start-label="VER PROPOSTA" data-viewer-continue-label="CONTINUAR APRESENTAÇÃO" type="button">VER PROPOSTA</button>
					</div>
					<img class="proposal-view-logo" src="/v1/assets/logo-viagate-white.svg" alt="ViaGate"/>
				</div>
			</div>
			<div class="proposal-view-navigation" data-viewer-controls aria-label="Navegação da proposta" hidden>
				<button type="button" data-viewer-previous aria-label="Slide anterior">↑</button>
				<span data-viewer-counter>01 / 01</span>
				<button type="button" data-viewer-next aria-label="Próximo slide">↓</button>
			</div>
			<script src="/commercial-assets/core.js" defer></script>
			<script src="/commercial-assets/form-controls.js" defer></script>
			<script src="/commercial-assets/public-viewer.js" defer></script>
		</body>
	</html>
}
