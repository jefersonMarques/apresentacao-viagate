package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/auditlog"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
)

templ AuditPage(user domain.User, entries []auditlog.Entry, query string) {
	@AdminLayout("Auditoria", user) {
		@AdminPageHeader("AUDITORIA", "Histórico técnico e de acesso", "Consulte ações administrativas, eventos de assinatura e visualizações registradas pela plataforma.")
		<div class="admin-list-root">
			@AdminServerSearchToolbar("/admin/audit", query, "Buscar evento, usuário, IP ou identificador...", len(entries), "evento(s)")
			@AdminDataTable([]string{"Quando", "Evento", "Responsável", "Recurso", "IP"}, len(entries), "Nenhum evento encontrado.") {
				for _, entry := range entries {
					<tr data-admin-list-row>
						<td data-label="Quando" data-primary="true"><strong>{ entry.OccurredAt.Format("02/01/2006 15:04:05") }</strong></td>
						<td data-label="Evento"><strong>{ AuditEventLabel(entry.EventType) }</strong><small>{ entry.EventType }</small></td>
						<td data-label="Responsável">{ entry.Actor }</td>
						<td data-label="Recurso">{ AuditResourceLabel(entry.ResourceType) }<small style="word-break:break-all">{ entry.ResourceID }</small></td>
						<td data-label="IP">{ entry.IPAddress }</td>
					</tr>
				}
			}
		</div>
	}
}
