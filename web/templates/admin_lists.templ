package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
	"github.com/jefersonMarques/apresentacao-viagate/internal/presentations"
)

templ ProposalListPage(user domain.User, items []domain.Proposal, defaultProposals []domain.Proposal) {
	@AdminLayout("ViaGate — Propostas", user) {
		@AdminPageHeader("PROPOSTAS", "Propostas comerciais", "Defina propostas como padrão para disponibilizá-las como modelos na criação de novas propostas.") {
			if UserCan(user, "proposal.create") {
				<a class="btn primary" href="/admin/proposals/new" data-proposal-source-open>Nova proposta</a>
			}
		}

		<section class="proposal-list-section">
			<div class="proposal-list-section-heading">
				<div>
					<span class="eyebrow">MODELOS</span>
					<h2>Propostas padrão</h2>
					<p>Somente estas propostas ficam disponíveis como modelos ao criar uma nova proposta.</p>
				</div>
			</div>
			if len(defaultProposals) > 0 {
				@AdminDataTable([]string{"Proposta", "Status", "Versão", "Atualizada", "Ações"}, len(defaultProposals), "Nenhuma proposta padrão definida.") {
					for _, item := range defaultProposals {
						<tr data-admin-list-row>
							<td data-label="Proposta" data-primary="true">
								<strong>{ item.Title }</strong>
								<small>{ item.ClientName }</small>
							</td>
							<td data-label="Status"><span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ humanStatus(item.Status) }</span></td>
							<td data-label="Versão">v{ item.CurrentVersion }</td>
							<td data-label="Atualizada">{ item.UpdatedAt.Format("02/01/2006 15:04") }</td>
							<td data-label="Ações" data-actions="true">
								<div class="admin-list-actions">
									if UserCan(user, "proposal.create") && UserCan(user, "proposal.duplicate") {
										<a class="btn primary" href={ templ.SafeURL("/admin/proposals/new?template=" + item.ID) }>Usar como modelo</a>
									}
									if item.PublicToken != "" {
										<a class="btn dark" target="_blank" rel="noopener" href={ templ.SafeURL("/p/" + item.PublicToken) }>Abrir</a>
									}
									if UserCan(user, "settings.manage") {
										<form method="post" action={ templ.SafeURL("/admin/proposals/" + item.ID + "/default") }>
											<input type="hidden" name="action" value="clear"/>
											<button class="btn" type="submit">Remover padrão</button>
										</form>
									}
								</div>
							</td>
						</tr>
					}
				}
			} else {
				<div class="proposal-default-empty">
					<strong>Nenhuma proposta padrão definida.</strong>
					if UserCan(user, "settings.manage") {
						<span>Use “Tornar padrão” em uma proposta abaixo para disponibilizá-la como modelo.</span>
					} else {
						<span>Um administrador pode definir os modelos disponíveis.</span>
					}
				</div>
			}
		</section>

		<section class="proposal-list-section">
			<div class="proposal-list-section-heading">
				<div>
					<span class="eyebrow">HISTÓRICO</span>
					<h2>Todas as propostas</h2>
					<p>Propostas marcadas como padrão são movidas para a lista de modelos acima.</p>
				</div>
			</div>
			<div class="admin-list-root" data-admin-list>
				@AdminListToolbar(ProposalRegularCount(items), "proposta(s)") {
					@AdminListSearch("Buscar cliente ou proposta...")
					@AdminListFilter("Status", "status") {
						<option value="">Todos os status</option>
						<option value="draft">Rascunho</option>
						<option value="published">Publicada</option>
						<option value="accepted">Aceita</option>
						<option value="expired">Expirada</option>
						<option value="cancelled">Cancelada</option>
					}
				}
				@AdminDataTable([]string{"Cliente", "Proposta", "Status", "Versão", "Validade", "Atualizada", "Ações"}, ProposalRegularCount(items), "Nenhuma proposta encontrada.") {
					for _, item := range items {
						if !item.IsDefault {
							<tr data-admin-list-row data-search={ item.ClientName + " " + item.Title } data-filter-status={ item.Status }>
								<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
								<td data-label="Proposta">{ item.Title }</td>
								<td data-label="Status">
									<span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ humanStatus(item.Status) }</span>
								</td>
								<td data-label="Versão">v{ item.CurrentVersion }</td>
								<td data-label="Validade">{ Date(item.ValidUntil) }</td>
								<td data-label="Atualizada">{ item.UpdatedAt.Format("02/01/2006 15:04") }</td>
								<td data-label="Ações" data-actions="true">
									<div class="admin-list-actions">
										if item.Status != "accepted" && item.Status != "cancelled" {
											<a class="btn" href={ templ.SafeURL("/admin/proposals/" + item.ID + "/edit") }>Editar</a>
										} else if item.PublicToken != "" {
											<a class="btn dark" target="_blank" rel="noopener" href={ templ.SafeURL("/p/" + item.PublicToken) }>Abrir</a>
										}
										@AdminActionMenu("Mais ações da proposta") {
											if UserCan(user, "proposal.duplicate") {
												<a href={ templ.SafeURL("/admin/proposals/new?duplicate=" + item.ID) }>Duplicar proposta</a>
											}
											if UserCan(user, "settings.manage") {
												<form method="post" action={ templ.SafeURL("/admin/proposals/" + item.ID + "/default") }>
													<input type="hidden" name="action" value="set"/>
													<button type="submit">Tornar padrão</button>
												</form>
											}
											if item.PublicToken != "" {
												<a
													href={ templ.SafeURL("/admin/proposals?pdf=" + item.ID) }
													data-long-action="download"
													data-action-title="Preparando proposta"
													data-action-message="Estamos capturando e organizando as páginas do PDF."
													data-action-success="A proposta foi preparada e o download começou."
												>Baixar PDF</a>
												<a target="_blank" rel="noopener" href={ templ.SafeURL("/p/" + item.PublicToken) }>Abrir versão pública</a>
												<button type="button" data-copy-path={ "/p/" + item.PublicToken }>Copiar link público</button>
											}
										}
									</div>
								</td>
							</tr>
						}
					}
				}
			</div>
		</section>

		if UserCan(user, "proposal.create") {
			<dialog class="proposal-source-dialog" data-proposal-source-dialog aria-labelledby="proposal-source-title">
				<div class="proposal-source-dialog-card">
					<header class="proposal-source-dialog-head">
						<div>
							<span class="eyebrow">NOVA PROPOSTA</span>
							<h2 id="proposal-source-title">Como deseja começar?</h2>
							<p>Escolha um modelo padrão ou comece com uma proposta vazia.</p>
						</div>
						<button type="button" class="proposal-source-close" data-proposal-source-close aria-label="Fechar">×</button>
					</header>
					<div class="proposal-source-dialog-body">
						if UserCan(user, "proposal.duplicate") && len(defaultProposals) > 0 {
							<section class="proposal-source-existing">
								<div class="proposal-source-existing-head">
									<div>
										<strong>Propostas padrão</strong>
										<small>Os dados do cliente serão removidos antes de abrir o editor.</small>
									</div>
									if len(defaultProposals) > 1 {
										<input type="search" placeholder="Buscar modelo..." autocomplete="off" data-proposal-source-search/>
									}
								</div>
								<div class="proposal-source-options">
									for _, item := range defaultProposals {
										<div class="proposal-source-option" data-proposal-source-option data-search={ item.ClientName + " " + item.Title }>
											<div>
												<span class="proposal-source-label">PADRÃO</span>
												<strong>{ item.Title }</strong>
												<small>{ item.ClientName } · { humanStatus(item.Status) }</small>
											</div>
											<a class="btn primary" href={ templ.SafeURL("/admin/proposals/new?template=" + item.ID) }>Usar</a>
										</div>
									}
									<div class="proposal-source-no-results" data-proposal-source-empty hidden>Nenhum modelo encontrado.</div>
								</div>
							</section>
						} else {
							<div class="proposal-default-empty">
								<strong>Nenhum modelo padrão disponível.</strong>
								<span>Você ainda pode iniciar uma proposta do zero.</span>
							</div>
						}

						<div class="proposal-source-blank">
							<div>
								<strong>Começar do zero</strong>
								<small>Abre o editor sem produtos, condições ou dados de outra proposta.</small>
							</div>
							<a class="btn dark" href="/admin/proposals/new">Iniciar do zero</a>
						</div>
					</div>
				</div>
			</dialog>
		}
	}
}

templ PresentationListPage(user domain.User, items []presentations.Presentation) {
	@AdminLayout("ViaGate — Apresentações", user) {
		@AdminPageHeader("APRESENTAÇÕES", "Materiais institucionais", "Super Admin visualiza todos os materiais; o comercial visualiza apenas os próprios.") {
			<a class="btn primary" href="/admin/presentations/new">Nova apresentação</a>
		}
		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "apresentação(ões)") {
				@AdminListSearch("Buscar cliente ou apresentação...")
				@AdminListFilter("Status", "status") {
					<option value="">Todos os status</option>
					<option value="draft">Rascunho</option>
					<option value="published">Publicada</option>
					<option value="expired">Expirada</option>
					<option value="cancelled">Cancelada</option>
				}
			}
			@AdminDataTable([]string{"Cliente", "Título", "Status", "Versão", "Atualizada", "Ações"}, len(items), "Nenhuma apresentação encontrada.") {
				for _, item := range items {
					<tr data-admin-list-row data-search={ item.ClientName + " " + item.Title } data-filter-status={ item.Status }>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Título">{ item.Title }</td>
						<td data-label="Status"><span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ humanStatus(item.Status) }</span></td>
						<td data-label="Versão">v{ item.CurrentVersion }</td>
						<td data-label="Atualizada">{ item.UpdatedAt.Format("02/01/2006 15:04") }</td>
						<td data-label="Ações" data-actions="true">
							<div class="admin-list-actions">
								<a class="btn" href={ templ.SafeURL("/admin/presentations/" + item.ID + "/edit") }>Editar</a>
								if item.PublicToken != "" {
									@AdminActionMenu("Mais ações da apresentação") {
										<a
											href={ templ.SafeURL("/admin/presentations?pdf=" + item.ID) }
											data-long-action="download"
											data-action-title="Preparando apresentação"
											data-action-message="Estamos capturando e organizando as páginas do PDF."
											data-action-success="A apresentação foi preparada e o download começou."
										>Baixar PDF</a>
										<a target="_blank" rel="noopener" href={ templ.SafeURL("/a/" + item.PublicToken) }>Abrir versão pública</a>
										<button type="button" data-copy-path={ "/a/" + item.PublicToken }>Copiar link público</button>
									}
								}
							</div>
						</td>
					</tr>
				}
			}
		</div>
	}
}
