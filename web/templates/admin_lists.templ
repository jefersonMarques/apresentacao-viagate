package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
	"github.com/jefersonMarques/apresentacao-viagate/internal/presentations"
)

templ ProposalListPage(user domain.User, items []domain.Proposal) {
	@AdminLayout("ViaGate — Propostas", user) {
		@AdminPageHeader("PROPOSTAS", "Propostas comerciais", "Propostas aceitas são imutáveis. Para reaproveitar estrutura, produtos e condições, duplique a proposta e crie uma nova negociação sem os dados do cliente anterior.") {
			<a class="btn primary" href="/admin/proposals/new">Nova proposta</a>
		}
		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "proposta(s)") {
				@AdminListSearch("Buscar cliente ou proposta...")
				@AdminListFilter("Status", "status") {
					<option value="">Todos os status</option>
					<option value="draft">Rascunho</option>
					<option value="published">Publicada</option>
					<option value="accepted">Aceita</option>
					<option value="expired">Expirada</option>
					<option value="cancelled">Cancelada</option>
				}
			}
			@AdminDataTable([]string{"Cliente", "Proposta", "Status", "Versão", "Validade", "Atualizada", "Ações"}, len(items), "Nenhuma proposta encontrada.") {
				for _, item := range items {
					<tr data-admin-list-row data-search={ item.ClientName + " " + item.Title } data-filter-status={ item.Status }>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Proposta">{ item.Title }</td>
						<td data-label="Status">
							if item.Status == "accepted" {
								<span class="badge status-badge status-success">Aceita · bloqueada</span>
							} else {
								<span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ humanStatus(item.Status) }</span>
							}
						</td>
						<td data-label="Versão">v{ item.CurrentVersion }</td>
						<td data-label="Validade">{ Date(item.ValidUntil) }</td>
						<td data-label="Atualizada">{ item.UpdatedAt.Format("02/01/2006 15:04") }</td>
						<td data-label="Ações" data-actions="true">
							<div class="admin-list-actions">
								if item.Status != "accepted" && item.Status != "cancelled" {
									<a class="btn" href={ templ.SafeURL("/admin/proposals/" + item.ID + "/edit") }>Editar</a>
								} else if item.PublicToken != "" {
									<a class="btn dark" target="_blank" rel="noopener" href={ templ.SafeURL("/p/" + item.PublicToken) }>Abrir</a>
								}
								@AdminActionMenu("Mais ações da proposta") {
									<a href={ templ.SafeURL("/admin/proposals/new?duplicate=" + item.ID) }>Duplicar proposta</a>
									if item.PublicToken != "" {
										<a href={ templ.SafeURL("/admin/proposals?pdf=" + item.ID) }>Baixar PDF</a>
										<a target="_blank" rel="noopener" href={ templ.SafeURL("/p/" + item.PublicToken) }>Abrir versão pública</a>
										<button type="button" data-copy-path={ "/p/" + item.PublicToken }>Copiar link público</button>
									}
								}
							</div>
						</td>
					</tr>
				}
			}
		</div>
	}
}

templ PresentationListPage(user domain.User, items []presentations.Presentation) {
	@AdminLayout("ViaGate — Apresentações", user) {
		@AdminPageHeader("APRESENTAÇÕES", "Materiais institucionais", "Super Admin visualiza todos os materiais; o comercial visualiza apenas os próprios.") {
			<a class="btn primary" href="/admin/presentations/new">Nova apresentação</a>
		}
		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "apresentação(ões)") {
				@AdminListSearch("Buscar cliente ou apresentação...")
				@AdminListFilter("Status", "status") {
					<option value="">Todos os status</option>
					<option value="draft">Rascunho</option>
					<option value="published">Publicada</option>
					<option value="expired">Expirada</option>
					<option value="cancelled">Cancelada</option>
				}
			}
			@AdminDataTable([]string{"Cliente", "Título", "Status", "Versão", "Atualizada", "Ações"}, len(items), "Nenhuma apresentação encontrada.") {
				for _, item := range items {
					<tr data-admin-list-row data-search={ item.ClientName + " " + item.Title } data-filter-status={ item.Status }>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Título">{ item.Title }</td>
						<td data-label="Status"><span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ humanStatus(item.Status) }</span></td>
						<td data-label="Versão">v{ item.CurrentVersion }</td>
						<td data-label="Atualizada">{ item.UpdatedAt.Format("02/01/2006 15:04") }</td>
						<td data-label="Ações" data-actions="true">
							<div class="admin-list-actions">
								<a class="btn" href={ templ.SafeURL("/admin/presentations/" + item.ID + "/edit") }>Editar</a>
								if item.PublicToken != "" {
									@AdminActionMenu("Mais ações da apresentação") {
										<a href={ templ.SafeURL("/admin/presentations?pdf=" + item.ID) }>Baixar PDF</a>
										<a target="_blank" rel="noopener" href={ templ.SafeURL("/a/" + item.PublicToken) }>Abrir versão pública</a>
										<button type="button" data-copy-path={ "/a/" + item.PublicToken }>Copiar link público</button>
									}
								}
							</div>
						</td>
					</tr>
				}
			}
		</div>
	}
}
