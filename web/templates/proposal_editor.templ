package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/catalog"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
	"github.com/jefersonMarques/apresentacao-viagate/internal/proposals"
)

templ ProposalEditorPage(user domain.User, input proposals.EditorInput, draft proposals.SavedDraft, message, errorMessage string) {
	@AdminLayout("ViaGate — Editor de proposta", user) {
		<header class="header">
			<div>
				<span class="step-title">GERADOR DE PROPOSTA</span>
				if input.ProposalID == "" {
					<h1>Nova proposta</h1>
				} else {
					<h1>Editar proposta</h1>
				}
				<p>Selecione o modelo, marque apenas o que será oferecido e informe os valores. Publicar congela esta versão; qualquer alteração posterior cria uma nova versão.</p>
			</div>
			<div class="actions"><a class="btn" href="/admin/proposals">Voltar</a></div>
		</header>
		if message != "" {
			<div class="notice">{ message }</div>
		}
		if errorMessage != "" {
			<div class="notice error">{ errorMessage }</div>
		}
		<form method="post" action="/admin/proposals/save" id="proposal-editor">
			<input type="hidden" name="proposal_id" value={ input.ProposalID }/>
			<section class="panel">
				<div class="panel-head"><h2>1. Cliente</h2></div>
				<div class="panel-body grid">
					<div class="field"><label>Razão social</label><input name="client_legal_name" value={ input.ClientLegalName } required/></div>
					<div class="field"><label>Nome fantasia</label><input name="client_trade_name" value={ input.ClientTradeName }/></div>
					<div class="field"><label>CNPJ</label><input name="client_cnpj" data-mask="cnpj" autocomplete="off" value={ input.ClientCNPJ }/></div>
					<div class="field"><label>E-mail</label><input name="client_email" type="email" value={ input.ClientEmail }/></div>
					<div class="field"><label>Telefone</label><input name="client_phone" data-mask="phone" autocomplete="tel" value={ input.ClientPhone }/></div>
					<div class="field"><label>Validade</label><input name="valid_until" type="date" value={ editorDate(input.ValidUntil) }/></div>
					<div class="field full"><label>Título interno</label><input name="title" value={ proposalTitle(input.Title) } required/></div>
				</div>
			</section>
			<section class="panel">
				<div class="panel-head"><h2>2. Modelo comercial</h2></div>
				<div class="panel-body grid">
					for _, model := range catalog.PricingModels {
						<label class="panel" style="margin:0;padding:16px;cursor:pointer">
							<input type="radio" name="pricing_model" value={ model.ID } checked?={ IsPricingModel(input, model.ID) }/>
							<strong style="display:block;margin-top:8px">{ model.Title }</strong>
							<small>{ model.Summary }</small>
						</label>
					}
				</div>
			</section>
			<section class="panel">
				<div class="panel-head"><h2>3. Produtos e valores</h2></div>
				<div class="panel-body">
					for _, group := range catalog.Groups {
						<section class="panel" data-catalog-group={ group.ID }>
							<div class="panel-head">
								<div><strong>{ group.ShortTitle }</strong><small style="display:block;color:#6e7e89;margin-top:4px">{ group.Summary }</small></div>
							</div>
							<div class="table-wrap">
								<table class="table">
									<thead><tr><th>Item</th><th>Status</th><th>Valor</th></tr></thead>
									<tbody>
										for _, catalogItem := range group.Items {
											{{ existing, found := ProposalEditorItem(input, catalogItem.ID) }}
											<tr data-models={ joinModels(catalogItem.Models) }>
												<td>
													<strong>{ catalogItem.Label }</strong>
													<small style="display:block;color:#6e7e89">{ catalogItem.Unit }</small>
													<input type="hidden" name="catalog_id" value={ catalogItem.ID }/>
												</td>
												<td>
													<select name="item_status">
														<option value="off" selected?={ !found }>Não oferecer</option>
														<option value="included" selected?={ found && !existing.IsOptional }>Incluído</option>
														<option value="optional" selected?={ found && existing.IsOptional }>Opcional</option>
													</select>
												</td>
												<td><input name="item_price" type="number" min="0" step="0.01" value={ editorPrice(existing.Price, found) } placeholder="0,00"/></td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</section>
					}
				</div>
			</section>
			<section class="panel">
				<div class="panel-head"><h2>4. Resumo financeiro</h2></div>
				<div class="panel-body grid">
					<div class="field"><label>Fatura mínima mensal</label><input name="minimum_invoice" type="number" min="0" step="0.01" value={ editorFloat(input.MinimumInvoice) }/></div>
					<div class="field"><label>Implantação</label><input name="setup_fee" type="number" min="0" step="0.01" value={ editorFloat(input.SetupFee) }/></div>
				</div>
			</section>
			<section class="panel">
				<div class="panel-head"><h2>5. Condições comerciais</h2></div>
				<div class="panel-body">
					<div class="grid">
						for _, condition := range catalog.StandardConditions {
							<label class="panel" style="margin:0;padding:14px">
								<input type="checkbox" name="condition" value={ condition.Text } checked?={ conditionChecked(input.Conditions, condition.Text) }/>
								<span>{ condition.Text }</span>
							</label>
						}
					</div>
					<div class="field" style="margin-top:16px"><label>Condição adicional</label><textarea name="custom_conditions" placeholder="Uma condição por linha"></textarea></div>
				</div>
			</section>
			<div class="actions">
				<button class="btn dark" type="submit" name="action" value="draft">Salvar rascunho</button>
				<button class="btn primary" type="submit" name="action" value="publish" data-processing="Publicando proposta...">Publicar versão</button>
				if draft.PublicToken != "" {
					<a class="btn" target="_blank" rel="noopener" href={ proposalPublicURL(draft.PublicToken) }>Abrir link público</a>
				}
			</div>
		</form>
		<script>
		(function(){const form=document.getElementById('proposal-editor');function sync(){const model=form.querySelector('[name=pricing_model]:checked')?.value||'per_item';form.querySelectorAll('tr[data-models]').forEach(row=>{const models=(row.dataset.models||'').split(',').filter(Boolean);row.hidden=models.length>0&&!models.includes(model);if(row.hidden){row.querySelector('[name=item_status]').value='off';}});}form.querySelectorAll('[name=pricing_model]').forEach(r=>r.addEventListener('change',sync));sync();})();
		</script>
	}
}
