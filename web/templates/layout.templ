package templates

import "github.com/jefersonMarques/apresentacao-viagate/internal/domain"

templ Base(title string) {
	<!doctype html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#071827"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/app.css"/>
			<link rel="stylesheet" href="/assets/square-corners.css"/>
		</head>
		<body>
			{ children... }
			<script src="/assets/app.js" defer></script>
		</body>
	</html>
}

templ AuthLayout(title string) {
	@Base(title) {
		<link rel="stylesheet" href="/assets/auth.css"/>
		{ children... }
	}
}

templ PublicFlowLayout(title string) {
	@Base(title) {
		<link rel="stylesheet" href="/assets/public-flow.css"/>
		{ children... }
	}
}

templ AdminLayout(title string, user domain.User) {
	@Base(title) {
		<link rel="stylesheet" href="/assets/admin-enhancements.css"/>
		<link rel="stylesheet" href="/assets/admin-list.css"/>
		<div class="admin-shell">
			<aside class="admin-sidebar">
				<a class="admin-brand" href="/admin">VIAGATE</a>
				<nav class="admin-nav">
					<a href="/admin">Visão geral</a>
					<a href="/admin/pipeline">Pipeline</a>
					<a href="/admin/proposals">Propostas</a>
					<a href="/admin/presentations">Apresentações</a>
					if HasRole(user, "super_admin") || HasRole(user, "operations") {
						<a href="/admin/onboardings">Cadastros</a>
						<a href="/admin/activations">Ativações</a>
					}
					if HasRole(user, "super_admin") || HasRole(user, "legal") {
						<a href="/admin/contracts">Contratos</a>
						<a href="/admin/contracts/templates">Modelos de contrato</a>
						<a href="/admin/audit">Auditoria</a>
					}
					if HasRole(user, "super_admin") {
						<a href="/admin/users">Usuários</a>
					}
				</nav>
				<div class="admin-sidebar-footer">
					<a href="/admin/profile">Meu perfil</a>
					<form method="post" action="/logout"><button type="submit">Sair</button></form>
				</div>
			</aside>
			<div class="admin-main">
				<header class="admin-topbar">
					<div><strong>{ user.Name }</strong><span>{ user.Email }</span></div>
				</header>
				<main class="admin-content">{ children... }</main>
			</div>
		</div>
		<script src="/assets/admin-list.js" defer></script>
	}
}

templ AdminEditorLayout(title string, user domain.User) {
	@AdminLayout(title, user) {
		<link rel="stylesheet" href="/assets/v1-admin-forms.css"/>
		<script src="/assets/form-controls.js" defer></script>
		{ children... }
	}
}
