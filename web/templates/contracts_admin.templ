package templates

import (
	"github.com/jefersonMarques/apresentacao-viagate/internal/contracts"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
)

templ ContractsAdminPage(user domain.User, items []contracts.AdminContractItem) {
	@AdminLayout("ViaGate — Contratos", user) {
		@AdminPageHeader("CONTRATOS", "Contratos da operação", "Acesse contratos gerados, assinaturas concluídas e os documentos comprobatórios da contratação.") {
			if HasRole(user, "super_admin") || HasRole(user, "legal") {
				<a class="btn" href="/admin/contracts/templates">Modelos de contrato</a>
			}
		}
		<section class="panel">
			<div class="panel-body">
				<strong>Verificação de autenticidade</strong>
				<p style="margin:6px 0 0;color:var(--muted)">Os contratos novos já levam um QR Code no próprio PDF para consulta pública e comparação do arquivo.</p>
				@ContractVerificationHelp()
			</div>
		</section>
		<div class="admin-list-root" data-admin-list>
			@AdminListToolbar(len(items), "contrato(s)") {
				@AdminListSearch("Buscar cliente, proposta, comercial ou responsável...")
				@AdminListFilter("Situação", "status") {
					<option value="">Todas as situações</option>
					<option value="generated">Preparado</option>
					<option value="sent">Aguardando assinatura</option>
					<option value="signed">Assinado</option>
					<option value="cancelled">Cancelado</option>
				}
			}
			@AdminDataTable([]string{"Cliente", "Proposta", "Comercial", "Situação", "Assinatura", "Ações"}, len(items), "Nenhum contrato encontrado.") {
				for _, item := range items {
					<tr class={ ContractAdminRowClass(item) } data-admin-list-row data-search={ item.ClientName + " " + item.ProposalTitle + " " + item.CommercialName + " " + item.SignerName } data-filter-status={ item.Status }>
						<td data-label="Cliente" data-primary="true"><strong>{ item.ClientName }</strong></td>
						<td data-label="Proposta">{ item.ProposalTitle }</td>
						<td data-label="Comercial">{ item.CommercialName }</td>
						<td data-label="Situação">
							if item.Status == "signed" {
								<span class="badge status-badge status-success">Contrato assinado</span>
							} else {
								<span class={ "badge status-badge " + AdminStatusBadgeClass(item.Status) }>{ humanStatus(item.Status) }</span>
							}
						</td>
						<td data-label="Assinatura">
							if item.FullySignedAt != nil {
								<strong>{ item.FullySignedAt.Format("02/01/2006 15:04") }</strong>
								if item.SignerName != "" {
									<small>por { item.SignerName }</small>
								}
							} else if item.SentAt != nil {
								<span>Aguardando assinatura</span>
							} else {
								<span>Contrato preparado</span>
							}
						</td>
						<td data-label="Ações" data-actions="true">
							<div class="admin-list-actions">
								<a class="btn" target="_blank" rel="noopener" href={ templ.SafeURL("/admin/contracts/" + item.ID + "/document") }>
									if item.Status == "signed" {
										<span>Contrato assinado</span>
									} else {
										<span>Abrir contrato</span>
									}
								</a>
								if item.FinalizedAt != nil {
									@AdminActionMenu("Mais documentos do contrato") {
										<a target="_blank" rel="noopener" href={ templ.SafeURL("/admin/contracts/" + item.ID + "/evidence") }>Relatório técnico da assinatura</a>
										<a target="_blank" rel="noopener" href={ templ.SafeURL("/admin/contracts/" + item.ID + "/package") }>Documentos da assinatura</a>
									}
								}
							</div>
						</td>
					</tr>
				}
			}
		</div>
	}
}
