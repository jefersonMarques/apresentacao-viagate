package templates

import (
	"github.com/a-h/templ"
	"github.com/jefersonMarques/apresentacao-viagate/internal/domain"
)

templ OnboardingFormPage(onboarding domain.Onboarding, message, errorMessage string, requireReview bool) {
	@Base("ViaGate — Dados da operação") {
		<header class="topbar">
			<span class="brand">VIAGATE · IMPLANTAÇÃO</span>
			<span>{ onboarding.LegalName }</span>
		</header>
		<main class="shell">
			<header class="header">
				<div>
					<span class="step-title">DADOS DA OPERAÇÃO</span>
					<h1>Informações para implantação</h1>
					<p>Revise os dados da empresa e complete as informações operacionais, responsáveis, apólice e usuários do sistema.</p>
				</div>
			</header>
			if message != "" {
				<div class="notice">{ message }</div>
			}
			if errorMessage != "" {
				<div class="notice error">{ errorMessage }</div>
			}
			<form method="post" action={ templ.SafeURL("/onboarding/" + onboarding.ID) }>
				<section class="panel">
					<div class="panel-head">
						<h2>Contratante</h2>
						<button class="btn" type="button" onclick="lookupCNPJ()">Preencher pelo CNPJ</button>
					</div>
					<div class="panel-body grid">
						<div class="field"><label>CNPJ</label><input id="cnpj" name="cnpj" data-mask="cnpj" value={ onboarding.CNPJ } autocomplete="off" required/></div>
						<div class="field"><label>Razão social</label><input id="legal_name" name="legal_name" value={ onboarding.LegalName } required/></div>
						<div class="field"><label>Nome fantasia</label><input id="trade_name" name="trade_name" value={ onboarding.TradeName }/></div>
						<div class="field"><label>CEP</label><input id="postal_code" name="postal_code" data-mask="postal-code" autocomplete="postal-code" value={ onboarding.PostalCode }/></div>
						<div class="field"><label>Logradouro</label><input id="street" name="street" value={ onboarding.Street }/></div>
						<div class="field"><label>Número</label><input id="street_number" name="street_number" value={ onboarding.StreetNumber }/></div>
						<div class="field"><label>Complemento</label><input id="complement" name="complement" value={ onboarding.Complement }/></div>
						<div class="field"><label>Bairro</label><input id="district" name="district" value={ onboarding.District }/></div>
						<div class="field"><label>Cidade</label><input id="city" name="city" value={ onboarding.City }/></div>
						<div class="field"><label>UF</label><input id="state" name="state" maxlength="2" value={ onboarding.State }/></div>
					</div>
				</section>
				<section class="panel">
					<div class="panel-head"><h2>Operação e apólice</h2></div>
					<div class="panel-body grid">
						<div class="field">
							<label>Tipo de operação</label>
							<select name="operation_type">
								<option value="normal" selected?={ onboarding.OperationType == "normal" }>Normal</option>
								<option value="avulsa" selected?={ onboarding.OperationType == "avulsa" }>Avulsa</option>
							</select>
						</div>
						<div class="field"><label>Seguradora</label><input name="insurer" value={ onboarding.Insurer } required/></div>
						<div class="field"><label>Início da vigência</label><input name="policy_start_date" type="date" value={ onboarding.PolicyStartDate } required/></div>
						<div class="field"><label>Fim da vigência</label><input name="policy_end_date" type="date" value={ onboarding.PolicyEndDate } required/></div>
						<div class="field"><label>Corretor parceiro</label><input name="broker_company" value={ onboarding.BrokerCompany }/></div>
						<div class="field"><label>Produtor do corretor</label><input name="broker_producer" value={ onboarding.BrokerProducer }/></div>
					</div>
				</section>
				<section class="panel">
					<div class="panel-head"><h2>Responsável pela empresa</h2></div>
					<div class="panel-body grid">
						<div class="field"><label>Nome completo</label><input name="responsible_name" value={ onboarding.CompanyResponsibleName } required/></div>
						<div class="field"><label>CPF</label><input name="responsible_cpf" data-mask="cpf" autocomplete="off" value={ onboarding.CompanyResponsibleCPF } required/></div>
						<div class="field"><label>Telefone</label><input name="responsible_phone" data-mask="phone" autocomplete="tel" value={ onboarding.CompanyResponsiblePhone } required/></div>
						<div class="field"><label>E-mail</label><input name="responsible_email" type="email" value={ onboarding.CompanyResponsibleEmail } required/></div>
						<div class="field full"><label>Cargo / função</label><input name="responsible_role" value={ onboarding.CompanyResponsibleRole }/></div>
						<div class="field full"><label><input type="checkbox" name="responsible_authority" value="1" checked?={ onboarding.AuthorityDeclared } required/> Declaro possuir poderes ou autorização para representar a empresa nesta contratação.</label></div>
					</div>
				</section>
				<section class="panel">
					<div class="panel-head"><h2>Responsável financeiro</h2></div>
					<div class="panel-body grid">
						<div class="field"><label>Nome</label><input name="finance_name" value={ onboarding.FinanceResponsibleName }/></div>
						<div class="field"><label>Telefone</label><input name="finance_phone" data-mask="phone" autocomplete="tel" value={ onboarding.FinanceResponsiblePhone }/></div>
						<div class="field"><label>E-mail</label><input name="finance_email" type="email" value={ onboarding.FinanceResponsibleEmail }/></div>
					</div>
				</section>
				<section class="panel">
					<div class="panel-head"><h2>Mercadorias transportadas</h2></div>
					<div class="panel-body" id="goods-list">
						for _, good := range onboarding.Goods {
							<div class="field" style="margin-bottom:8px"><input name="goods" value={ good }/></div>
						}
						<div class="field"><input name="goods" placeholder="Ex.: Queijos frescos"/></div>
						<button class="btn" type="button" onclick="addGood()" style="margin-top:10px">Adicionar mercadoria</button>
					</div>
				</section>
				<section class="panel">
					<div class="panel-head"><h2>Usuários que utilizarão o sistema</h2></div>
					<div class="panel-body" id="users-list">
						for _, systemUser := range onboarding.SystemUsers {
							<div class="repeat-row">
								<input name="system_user_name" placeholder="Nome" value={ systemUser.Name }/>
								<input name="system_user_phone" data-mask="phone" autocomplete="tel" placeholder="Telefone" value={ systemUser.Phone }/>
								<input name="system_user_email" type="email" placeholder="E-mail" value={ systemUser.Email }/>
								<button class="btn danger" type="button" onclick="this.parentElement.remove()">Remover</button>
							</div>
						}
						<div class="repeat-row">
							<input name="system_user_name" placeholder="Nome"/>
							<input name="system_user_phone" data-mask="phone" autocomplete="tel" placeholder="Telefone"/>
							<input name="system_user_email" type="email" placeholder="E-mail"/>
							<button class="btn danger" type="button" onclick="this.parentElement.remove()">Remover</button>
						</div>
						<button class="btn" type="button" onclick="addSystemUser()">Adicionar usuário</button>
					</div>
				</section>
				<div class="actions"><button class="btn dark" type="submit">Salvar dados</button></div>
			</form>
			<section class="panel" style="margin-top:18px">
				<div class="panel-head"><h2>Apólice</h2></div>
				<div class="panel-body">
					<form method="post" action={ templ.SafeURL("/onboarding/" + onboarding.ID + "/documents") } enctype="multipart/form-data">
						<div class="upload-drop">
							<div class="field"><label>Arquivo da apólice</label><input name="document" type="file" accept="application/pdf,image/jpeg,image/png" required/></div>
							<small>PDF, JPG ou PNG · até 15 MB. Um novo envio substitui a apólice anterior.</small>
							<button class="btn dark" type="submit" style="margin-top:12px">Enviar apólice</button>
						</div>
					</form>
				</div>
			</section>
			<section class="panel">
				<div class="panel-body">
					if requireReview {
						<p>Ao enviar, os dados e documentos ficarão bloqueados enquanto a ViaGate realiza a revisão. Caso seja necessário algum ajuste, você receberá um link seguro por e-mail.</p>
					} else {
						<p>Ao enviar, os dados serão validados e o contrato será preparado para assinatura.</p>
					}
					<form method="post" action={ templ.SafeURL("/onboarding/" + onboarding.ID + "/submit") }>
						if requireReview {
							<button class="btn primary" type="submit" data-processing="Enviando para revisão...">Enviar dados para revisão</button>
						} else {
							<button class="btn primary" type="submit" data-processing="Preparando contrato...">Enviar dados e preparar contrato</button>
						}
					</form>
				</div>
			</section>
			<script>
			async function lookupCNPJ(){const input=document.getElementById('cnpj');const cnpj=(input.value||'').toUpperCase().replace(/[^0-9A-Z]/g,'');if(!/^[0-9A-Z]{12}[0-9]{2}$/.test(cnpj)){alert('Informe um CNPJ válido, numérico ou alfanumérico.');return;}const r=await fetch('/api/cnpj/'+encodeURIComponent(cnpj));if(!r.ok){alert('Não foi possível consultar o CNPJ. Você pode preencher os dados manualmente.');return;}const d=await r.json();input.value=d.cnpj||cnpj;input.dispatchEvent(new Event('input',{bubbles:true}));for(const [id,key] of Object.entries({legal_name:'legal_name',trade_name:'trade_name',postal_code:'postal_code',street:'street',street_number:'number',complement:'complement',district:'district',city:'city',state:'state'})){const e=document.getElementById(id);if(e&&d[key]){e.value=d[key];e.dispatchEvent(new Event('input',{bubbles:true}));}}}
			function addGood(){const root=document.getElementById('goods-list');const wrapper=document.createElement('div');wrapper.className='field';wrapper.style.marginBottom='8px';wrapper.innerHTML='<input name="goods" placeholder="Mercadoria"/>';root.insertBefore(wrapper,root.lastElementChild);}
			function addSystemUser(){const root=document.getElementById('users-list');const row=document.createElement('div');row.className='repeat-row';row.innerHTML='<input name="system_user_name" placeholder="Nome"/><input name="system_user_phone" data-mask="phone" autocomplete="tel" placeholder="Telefone"/><input name="system_user_email" type="email" placeholder="E-mail"/><button class="btn danger" type="button" onclick="this.parentElement.remove()">Remover</button>';root.insertBefore(row,root.lastElementChild);}
			</script>
		</main>
	}
}
