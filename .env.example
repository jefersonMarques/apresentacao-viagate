APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://viagate:viagate@localhost:5432/viagate?sslmode=disable
# O renderer tenta localizar automaticamente Chrome, Edge ou Chromium.
CHROMIUM_PATH=chromium
# Windows: se quiser fixar o executável, prefira barras normais para evitar escapes do dotenv/Taskfile.
# CHROMIUM_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# CHROMIUM_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Ative somente quando o Go estiver atrás de um proxy reverso confiável que sobrescreve X-Forwarded-For/X-Real-IP.
TRUST_PROXY_HEADERS=false
# Por padrão o cadastro passa por revisão interna antes de gerar/enviar o contrato.
REQUIRE_ONBOARDING_REVIEW=true
SESSION_COOKIE_NAME=viagate_session
SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=48
SIGNATURE_OTP_TTL_MINUTES=10

VIAGATE_LEGAL_NAME=
VIAGATE_CNPJ=

# Namespace físico dentro do bucket. Desenvolvimento usa dev/ e produção usa prod/.
S3_STAGE=dev
# Exemplo local com MinIO. Em endpoint S3 compatível, 'none' significa que o
# backend não envia o header AWS SSE; confirme criptografia em repouso no provedor.
S3_REGION=us-east-1
S3_BUCKET=viagate-commercial
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=none
S3_KMS_KEY_ID=
S3_DOWNLOAD_TTL_MINUTES=5

BREVO_API_KEY=
BREVO_SENDER_EMAIL=naoresponda@viagate.com.br
BREVO_SENDER_NAME=ViaGate

COMPANY_REGISTRY_PROVIDER=brasilapi
COMPANY_REGISTRY_TIMEOUT_SECONDS=4

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
